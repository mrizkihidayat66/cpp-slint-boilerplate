{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BOILERPLATE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x86-debug",
      "displayName": "x86 Debug (32-bit)",
      "inherits": "base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Rust_CARGO_TARGET": "i686-pc-windows-msvc"
      }
    },
    {
      "name": "x86-release",
      "displayName": "x86 Release (32-bit)",
      "inherits": "base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Rust_CARGO_TARGET": "i686-pc-windows-msvc"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug (host toolchain)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native Release (host toolchain)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base-skia",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "SLINT_FEATURE_RENDERER_FEMTOVG": "OFF",
        "SLINT_FEATURE_RENDERER_SKIA": "ON",
        "SLINT_FEATURE_RENDERER_SOFTWARE": "OFF"
      }
    },
    {
      "name": "x64-debug-skia",
      "displayName": "x64 Debug (Skia)",
      "inherits": "base-skia",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release-skia",
      "displayName": "x64 Release (Skia)",
      "inherits": "base-skia",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release"
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "x64-debug-skia",
      "configurePreset": "x64-debug-skia"
    },
    {
      "name": "x64-release-skia",
      "configurePreset": "x64-release-skia"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-debug-skia",
      "configurePreset": "x64-debug-skia",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-release-skia",
      "configurePreset": "x64-release-skia",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
