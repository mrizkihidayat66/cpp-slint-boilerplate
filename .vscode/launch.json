      "console": "integratedTerminal"
    },
    {
      "name": "Run unit tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/x64-debug/slint-boilerplate-tests.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
