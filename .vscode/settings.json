{
  // Slint LSP: live preview, syntax checking, formatting.
  // Install the workspace-recommended "slint.slint-vscode" extension.
  "slint.lsp-args": [],
  "[slint]": {
    "editor.formatOnSave": true
  },

  // clangd: use the compile database generated by CMake.
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/x64-debug",
    "--background-index"
  ],
  "C_Cpp.enabled": false,

  // CMake Tools: driven by the repository presets.
  "cmake.useCMakePresets": "always",

  // Formatting for C++ is normative (.clang-format at the repo root).
  "[cpp]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[c]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "files.associations": {
    "*.slint": "slint"
  }
}
