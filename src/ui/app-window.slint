// app-window.slint — root window: layout shell + model properties.
//
// The C++ side reaches the UI only through: AppWindow properties (models),
// and the AppState global (state + callback intents). Types and state live
// in app-state.slint; see docs/ARCHITECTURE.md for the data-flow rules.

import { Palette, Typography, Metrics } from "theme/theme.slint";
import { StatCard, ActivityItem, AppTableRow, AppState } from "app-state.slint";
import { AppInfo } from "app-info.slint";
import { AppSidebar } from "components/library.slint";
import { DashboardPage, TasksPage, SettingsPage, AboutPage, GalleryPage } from "pages/pages.slint";

// Re-export so the C++ side can reach it via window->global<AppState>();
// only exported globals appear in the generated API. Palette is exported
// too — the settings flow flips its `dark` flag for the live theme switch.
export { AppState } from "app-state.slint";
export { AppInfo } from "app-info.slint";
export { Palette } from "theme/theme.slint";

export component AppWindow inherits Window {
    title: AppInfo.technical-name;
    preferred-width: 1024px;
    preferred-height: 680px;
    min-width: Metrics.window-min-width;
    min-height: Metrics.window-min-height;
    background: Palette.background;

    // Models owned by the C++ side; the pages consume them.
    in-out property <[StatCard]> stat-cards: [];
    in-out property <[ActivityItem]> recent-activity: [];

    // Sidebar collapse flag. Set imperatively in a `changed` handler: a plain
    // declarative binding (`collapsed: root.width < 600px`) forms a binding
    // loop window-layout -> collapsed -> sidebar-width -> window-layout, which
    // the interpreter preview refuses to render.
    private property <bool> sidebar-collapsed: false;
    changed width => {
        root.sidebar-collapsed = root.width < 600px;
    }

    HorizontalLayout {
        AppSidebar {
            brand-title: AppInfo.display-name;
            brand-subtitle: "C++ · Slint";
            items: [
                { icon-name: "home", label: "Dashboard" },
                { icon-name: "document", label: "Tasks" },
                { icon-name: "grid", label: "Components" },
                { icon-name: "settings", label: "Settings" },
                { icon-name: "info", label: "About" },
            ];
            current-index <=> AppState.current-page;
            collapsed: root.sidebar-collapsed;
            navigate(index) => {
                AppState.request-navigation(index);
            }
        }

        Rectangle {
            background: Palette.background;

            if AppState.current-page == 0 : DashboardPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                stat-cards: root.stat-cards;
                recent-activity: root.recent-activity;
            }
            if AppState.current-page == 1 : TasksPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
            if AppState.current-page == 2 : GalleryPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
            if AppState.current-page == 3 : SettingsPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
            if AppState.current-page == 4 : AboutPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
