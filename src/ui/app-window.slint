// app-window.slint — root window: namespace, shared structs, app state.
//
// Phase-1 skeleton: an empty window proving the toolchain. The shell (sidebar
// + page switching) arrives with the C++ architecture phase.

import { Palette, Typography, Metrics } from "theme/theme.slint";
import { AppButton, AppCard } from "components/library.slint";

export namespace app {
    // Shared state between the UI and the C++ side. C++ pushes state via
    // property setters on this global and receives intents via callbacks.
    export global AppState {
        in-out property <int> current-page: 0;
        in-out property <string> status-message: "";
        callback request-navigation(int);
        callback request-quit();
    }
}

export component AppWindow inherits Window {
    title: "cpp-slint-boilerplate";
    min-width: Metrics.window-min-width;
    min-height: Metrics.window-min-height;
    background: Palette.background;

    AppCard {
        title: "Boilerplate skeleton";
        subtitle: "Phase 1 — toolchain check";
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(420px, parent.width - 2 * Metrics.space-4);

        AppButton {
            text: "Click me";
            clicked => {
                app::AppState.status-message = "Toolchain works!";
            }
        }
    }

    if app::AppState.status-message != "" : Text {
        x: 0;
        width: parent.width;
        y: parent.height - self.height - Metrics.space-4;
        text: app::AppState.status-message;
        color: Palette.text-muted;
        font-size: Typography.font-size-sm;
        horizontal-alignment: center;
    }
}
