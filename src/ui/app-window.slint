// app-window.slint — root window: layout shell + model properties.
//
// The C++ side reaches the UI only through: AppWindow properties (models),
// and the AppState global (state + callback intents). Types and state live
// in app-state.slint; see docs/ARCHITECTURE.md for the data-flow rules.

import { Palette, Typography, Metrics } from "theme/theme.slint";
import { StatCard, ActivityItem, AppState } from "app-state.slint";
import { AppSidebar } from "components/library.slint";
import { DashboardPage, SettingsPage, AboutPage, GalleryPage } from "pages/pages.slint";

// Re-export so the C++ side can reach them via window->global<...>();
// only exported globals appear in the generated API. Palette is exported
// so Application can flip the live theme switch (Palette.dark) when the
// settings load or save.
export { AppState } from "app-state.slint";
export { Palette } from "theme/theme.slint";

export component AppWindow inherits Window {
    title: "cpp-slint-boilerplate";
    preferred-width: 1024px;
    preferred-height: 680px;
    min-width: Metrics.window-min-width;
    min-height: Metrics.window-min-height;
    background: Palette.background;

    // Models owned by the C++ side; the pages consume them.
    in-out property <[StatCard]> stat-cards: [];
    in-out property <[ActivityItem]> recent-activity: [];

    HorizontalLayout {
        AppSidebar {
            brand-title: "Boilerplate";
            brand-subtitle: "C++ · Slint";
            items: [
                { icon-name: "home", label: "Dashboard" },
                { icon-name: "grid", label: "Components" },
                { icon-name: "settings", label: "Settings" },
                { icon-name: "info", label: "About" },
            ];
            current-index <=> AppState.current-page;
            collapsed: root.width < 600px;
            navigate(index) => {
                AppState.request-navigation(index);
            }
        }

        Rectangle {
            background: Palette.background;

            if AppState.current-page == 0 : DashboardPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                stat-cards: root.stat-cards;
                recent-activity: root.recent-activity;
            }
            if AppState.current-page == 1 : GalleryPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
            if AppState.current-page == 2 : SettingsPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
            if AppState.current-page == 3 : AboutPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
