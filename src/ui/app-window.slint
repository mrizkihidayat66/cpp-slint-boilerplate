// app-window.slint — root window for the simple example.
//
// Everything a Slint app needs in one markup file tree: data lives directly
// in the markup (in-out properties), navigation is pure UI state. The C++
// side only creates this window and runs the event loop — see main.cpp.

import { Palette, Typography, Metrics } from "theme/theme.slint";
import { AppSidebar } from "components/library.slint";
import { DashboardPage, AboutPage } from "pages/pages.slint";
import { AppInfo } from "app-info.slint";

export { AppInfo } from "app-info.slint";

export component AppWindow inherits Window {
    title: AppInfo.technical-name + " — simple";
    preferred-width: 1024px;
    preferred-height: 680px;
    min-width: Metrics.window-min-width;
    min-height: Metrics.window-min-height;
    background: Palette.background;

    // Pure UI state: which sidebar entry is selected.
    in-out property <int> current-page: 0;

    // Derived from width, but stored so the binding does not loop: writing
    // to a property that also drives the layout from inside its own change
    // handler makes the value flip-flop.
    private property <bool> sidebar-collapsed: false;
    changed width => { root.sidebar-collapsed = root.width < 600px; }

    HorizontalLayout {
        AppSidebar {
            brand-title: AppInfo.display-name;
            brand-subtitle: "C++ · Slint";
            items: [
                { icon-name: "home", label: "Dashboard" },
                { icon-name: "info", label: "About" },
            ];
            current-index <=> root.current-page;
            collapsed: root.sidebar-collapsed;
        }

        Rectangle {
            background: Palette.background;

            if root.current-page == 0 : DashboardPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
            if root.current-page == 1 : AboutPage {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
