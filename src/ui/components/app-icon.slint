// AppIcon — the bundled vector icon set.
//
// Every glyph is a 24-unit viewBox stroke path (Lucide-style outlines) drawn
// by a single `Path` element, so icons stay crisp at any size with no font or
// image dependency — the old glyph-font approach rendered as tofu boxes under
// femtovg.
//
// The glyph for a name is chosen by an `if/else if` chain over `name`
// (Slint functions cannot loop, and there is no map type). The alternatives
// were measured against the Slint 1.18 compiler:
//   * `for` over an array of structs + `visible:` per element instantiates one
//     element per entry (and `visible:` lowers to an injected Clip element, so
//     ~2N elements) — fine for a list, wasteful for a 1-of-N lookup.
//   * `array.index-of(...)` / `find-index(...)` are experimental features
//     (need SLINT_FEATURE_EXPERIMENTAL) and subject to change.
//   * `@image-url()` is resolved at compile time, so a runtime name cannot
//     select an SVG file; bundling .svg assets would need a C++ load path and
//     still a chain to map the name.
// The chain keeps every icon at exactly one element and adds no dependency.
//
// To add an icon: append an `else if (name == "…")` branch below AND add the
// name to `AppIcons.names`. Unknown names render the neutral circle + dot
// placeholder so a typo stays visible instead of silently disappearing.

import { Palette, Typography, Metrics } from "../theme/theme.slint";

// Catalog of every built-in icon name, for pickers, galleries, and any UI that
// wants to enumerate the set. Keep it in sync with the chain in `AppIcon`.
export global AppIcons {
    out property <[string]> names: [
        // Navigation & arrows
        "home", "menu",
        "chevron-up", "chevron-down", "chevron-left", "chevron-right",
        "chevrons-left", "chevrons-right",
        "arrow-up", "arrow-down", "arrow-left", "arrow-right",
        "external-link",
        // Actions
        "plus", "minus", "close", "check", "edit", "trash",
        "copy", "save", "download", "upload", "refresh",
        "search", "filter", "sort", "link", "share",
        "more-horizontal", "more-vertical", "logout", "log-in",
        // Status & feedback
        "info", "warning", "error", "check-circle", "x-circle", "help-circle",
        "activity",
        // Files & data
        "document", "folder", "clipboard", "chart", "pie-chart", "database",
        "image", "trending-up", "trending-down",
        // Media & communication
        "play", "pause", "stop", "skip-back", "skip-forward",
        "volume", "mute", "camera", "video", "mail", "bell", "send",
        // People
        "user", "users", "user-plus",
        // Objects & misc
        "settings", "grid", "calendar", "clock",
        "lock", "unlock", "eye", "eye-off",
        "star", "bookmark", "tag",
        "globe", "map-pin", "sun", "moon", "cloud",
        "wifi", "battery", "power", "zap", "shield", "award",
        "shopping-cart", "credit-card", "gift", "package", "layers",
        "monitor", "smartphone", "printer", "coffee",
    ];
}

export component AppIcon inherits Rectangle {
    /// Icon name (see the name table below). Unknown names fall back to
    /// the "placeholder" shape so mistakes stay visible.
    in property <string> name;
    /// Glyph size (square).
    in property <length> size: 16px;
    /// Stroke color.
    in property <color> accent-color: Palette.text;
    /// Stroke weight multiplier (1 = light, 2 = normal, 3 = bold).
    in property <float> stroke-weight: 1;

    width: root.size;
    height: root.size;
    clip: true;

    // Normalized selection state: each icon contributes one path spec.
    private property <string> d: {
        // --- Navigation & arrows ---------------------------------------------
        if (name == "home") { return "M3 11 L12 3 L21 11 M5 9.5 L5 20 L10 20 L10 14 L14 14 L14 20 L19 20 L19 9.5"; }
        else if (name == "menu") { return "M4 7 L20 7 M4 12 L20 12 M4 17 L20 17"; }
        else if (name == "chevron-up") { return "M6 14 L12 8 L18 14"; }
        else if (name == "chevron-down") { return "M6 10 L12 16 L18 10"; }
        else if (name == "chevron-left") { return "M14 6 L8 12 L14 18"; }
        else if (name == "chevron-right") { return "M10 6 L16 12 L10 18"; }
        else if (name == "chevrons-left") { return "M11 17 L6 12 L11 7 M18 17 L13 12 L18 7"; }
        else if (name == "chevrons-right") { return "M13 7 L18 12 L13 17 M6 7 L11 12 L6 17"; }
        else if (name == "arrow-up") { return "M12 20 L12 4 M5 11 L12 4 L19 11"; }
        else if (name == "arrow-down") { return "M12 4 L12 20 M5 13 L12 20 L19 13"; }
        else if (name == "arrow-left") { return "M20 12 L4 12 M11 5 L4 12 L11 19"; }
        else if (name == "arrow-right") { return "M4 12 L20 12 M13 5 L20 12 L13 19"; }
        else if (name == "external-link") { return "M18 13 L18 19 A1 1 0 0 1 17 20 L5 20 A1 1 0 0 1 4 19 L4 7 A1 1 0 0 1 5 6 L11 6 M15 4 L20 4 L20 9 M20 4 L11 13"; }

        // --- Actions ----------------------------------------------------------
        else if (name == "plus") { return "M12 5 L12 19 M5 12 L19 12"; }
        else if (name == "minus") { return "M5 12 L19 12"; }
        else if (name == "close") { return "M6 6 L18 18 M18 6 L6 18"; }
        else if (name == "check") { return "M4 12.5 L9.5 18 L20 7"; }
        else if (name == "edit") { return "M12 20 L20 20 M16.5 3.5 A2.1 2.1 0 0 1 19.5 6.5 L8 18 L4 19 L5 15 Z"; }
        else if (name == "trash") { return "M4 7 L20 7 M10 11 L10 17 M14 11 L14 17 M6 7 L7.5 20 L16.5 20 L18 7 M9 7 L9 4 L15 4 L15 7"; }
        else if (name == "copy") { return "M9 9 A1 1 0 0 1 10 8 L20 8 A1 1 0 0 1 21 9 L21 19 A1 1 0 0 1 20 20 L10 20 A1 1 0 0 1 9 19 Z M5 16 A1 1 0 0 1 4 15 L4 5 A1 1 0 0 1 5 4 L15 4 A1 1 0 0 1 16 5 L16 6"; }
        else if (name == "save") { return "M5 3 L16 3 L20 7 L20 20 A1 1 0 0 1 19 21 L5 21 A1 1 0 0 1 4 20 L4 4 A1 1 0 0 1 5 3 Z M8 3 L8 9 L15 9 L15 3 M7 21 L7 14 L17 14 L17 21"; }
        else if (name == "download") { return "M12 3 L12 15 M7 10 L12 15 L17 10 M4 20 L20 20"; }
        else if (name == "upload") { return "M12 16 L12 4 M7 9 L12 4 L17 9 M4 20 L20 20"; }
        else if (name == "refresh") { return "M21 12 A9 9 0 1 1 18 5.6 M21 3 L21 8 L16 8"; }
        else if (name == "search") { return "M11 18 A7 7 0 1 0 11 4 A7 7 0 0 0 11 18 M20 20 L16.2 16.2"; }
        else if (name == "filter") { return "M4 5 L20 5 L14 12.5 L14 18 L10 20 L10 12.5 Z"; }
        else if (name == "sort") { return "M7 4 L7 20 M4 17 L7 20 L10 17 M14 7 L14 7.01 M17 7 L17 7.01 M14 12 L17 12 M14 17 L17 17 M14 20 L17 20"; }
        else if (name == "link") { return "M9.5 14.5 L14.5 9.5 M10.5 6.5 L12.5 4.5 A4 4 0 0 1 19.5 11.5 L17.5 13.5 M13.5 17.5 L11.5 19.5 A4 4 0 0 1 4.5 12.5 L6.5 10.5"; }
        else if (name == "share") { return "M12 3 L12 15 M8 7 L12 3 L16 7 M5 12 L5 20 A1 1 0 0 0 6 21 L18 21 A1 1 0 0 0 19 20 L19 12"; }
        else if (name == "more-horizontal") { return "M6 12 L6 12.01 M12 12 L12 12.01 M18 12 L18 12.01"; }
        else if (name == "more-vertical") { return "M12 6 L12 6.01 M12 12 L12 12.01 M12 18 L12 18.01"; }
        else if (name == "logout") { return "M9 21 L5 21 A1 1 0 0 1 4 20 L4 4 A1 1 0 0 1 5 3 L9 3 M16 17 L21 12 L16 7 M21 12 L9 12"; }
        else if (name == "log-in") { return "M15 3 L19 3 A1 1 0 0 1 20 4 L20 20 A1 1 0 0 1 19 21 L15 21 M10 17 L15 12 L10 7 M15 12 L3 12"; }

        // --- Status & feedback ------------------------------------------------
        else if (name == "info") { return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M12 11 L12 16 M12 8 L12 8.01"; }
        else if (name == "warning") { return "M12 3 L22 20 L2 20 Z M12 10 L12 14 M12 17.2 L12 17.21"; }
        else if (name == "error") { return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M15 9 L9 15 M9 9 L15 15"; }
        else if (name == "check-circle") { return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M8 12 L11 15 L16 9"; }
        else if (name == "x-circle") { return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M9 9 L15 15 M15 9 L9 15"; }
        else if (name == "help-circle") { return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M9.3 9.5 A2.7 2.7 0 1 1 12 12.5 L12 14 M12 17.2 L12 17.21"; }
        else if (name == "activity") { return "M3 12 L7 12 L10 5 L14 19 L17 12 L21 12"; }

        // --- Files & data -----------------------------------------------------
        else if (name == "document") { return "M14 3 L6 3 A1 1 0 0 0 5 4 L5 20 A1 1 0 0 0 6 21 L18 21 A1 1 0 0 0 19 20 L19 8 Z M14 3 L14 8 L19 8 M9 13 L15 13 M9 17 L15 17"; }
        else if (name == "folder") { return "M3 7 A1 1 0 0 1 4 6 L9 6 L11 8.5 L20 8.5 A1 1 0 0 1 21 9.5 L21 18 A1 1 0 0 1 20 19 L4 19 A1 1 0 0 1 3 18 Z"; }
        else if (name == "clipboard") { return "M9 4 L9 3 A1 1 0 0 1 10 2 L14 2 A1 1 0 0 1 15 3 L15 4 M7 4 L6 4 A1 1 0 0 0 5 5 L5 20 A1 1 0 0 0 6 21 L18 21 A1 1 0 0 0 19 20 L19 5 A1 1 0 0 0 18 4 L17 4 M9 4 L15 4 M9 12 L15 12 M9 16 L13 16"; }
        else if (name == "chart") { return "M4 20 L20 20 M7 20 L7 13 M12 20 L12 6 M17 20 L17 10"; }
        else if (name == "pie-chart") { return "M12 12 L12 3 A9 9 0 1 1 3 12 Z"; }
        else if (name == "database") { return "M12 8 C16.4 8 20 6.7 20 5 C20 3.3 16.4 2 12 2 C7.6 2 4 3.3 4 5 C4 6.7 7.6 8 12 8 M4 5 L4 19 C4 20.7 7.6 22 12 22 C16.4 22 20 20.7 20 19 L20 5 M4 12 C4 13.7 7.6 15 12 15 C16.4 15 20 13.7 20 12"; }
        else if (name == "image") { return "M4 5 A1 1 0 0 1 5 4 L19 4 A1 1 0 0 1 20 5 L20 19 A1 1 0 0 1 19 20 L5 20 A1 1 0 0 1 4 19 Z M4 15 L9 10 L14 15 L17 12 L20 15 M9 8.5 L9 8.51"; }

        // --- Media & communication -------------------------------------------
        else if (name == "play") { return "M7 4 L19 12 L7 20 Z"; }
        else if (name == "pause") { return "M9 4 L9 20 M15 4 L15 20"; }
        else if (name == "stop") { return "M6 6 L18 6 L18 18 L6 18 Z"; }
        else if (name == "skip-back") { return "M18 5 L8 12 L18 19 Z M6 5 L6 19"; }
        else if (name == "skip-forward") { return "M6 5 L16 12 L6 19 Z M18 5 L18 19"; }
        else if (name == "volume") { return "M11 5 L6 9 L3 9 L3 15 L6 15 L11 19 Z M15.5 9 A4 4 0 0 1 15.5 15 M18.5 6 A8 8 0 0 1 18.5 18"; }
        else if (name == "mute") { return "M11 5 L6 9 L3 9 L3 15 L6 15 L11 19 Z M16 9.5 L21 14.5 M21 9.5 L16 14.5"; }
        else if (name == "camera") { return "M4 8 A1 1 0 0 1 5 7 L8 7 L9.5 5 L14.5 5 L16 7 L19 7 A1 1 0 0 1 20 8 L20 18 A1 1 0 0 1 19 19 L5 19 A1 1 0 0 1 4 18 Z M12 16 A3.5 3.5 0 1 0 12 9 A3.5 3.5 0 0 0 12 16"; }
        else if (name == "video") { return "M4 6 A1 1 0 0 1 5 5 L15 5 A1 1 0 0 1 16 6 L16 18 A1 1 0 0 1 15 19 L5 19 A1 1 0 0 1 4 18 Z M16 10 L20 7 L20 17 L16 14 Z"; }
        else if (name == "mail") { return "M3 6 A1 1 0 0 1 4 5 L20 5 A1 1 0 0 1 21 6 L21 18 A1 1 0 0 1 20 19 L4 19 A1 1 0 0 1 3 18 Z M3 6.5 L12 13 L21 6.5"; }
        else if (name == "bell") { return "M6 8 A6 6 0 0 1 18 8 L18 14 L21 17 L3 17 L6 14 Z M13.5 20 A2 2 0 0 1 10.5 20"; }
        else if (name == "send") { return "M22 2 L11 13 M22 2 L15 22 L11 13 L2 9 Z"; }

        // --- People -----------------------------------------------------------
        else if (name == "user") { return "M20 21 C20 17.1 16.4 14 12 14 C7.6 14 4 17.1 4 21 M12 11 A4 4 0 1 0 12 3 A4 4 0 0 0 12 11"; }
        else if (name == "users") { return "M17 21 C17 18.2 14.9 16 12.5 16 L7.5 16 C5 16 3 18.2 3 21 M15 7.5 A3.5 3.5 0 1 0 8 7.5 A3.5 3.5 0 0 0 15 7.5 M21 21 C21 18.6 19.7 16.9 17.8 16.2 M16.5 3.4 A3.5 3.5 0 0 1 16.5 10.1"; }
        else if (name == "user-plus") { return "M15 21 C15 17.1 11.9 14 8 14 C4.1 14 1 17.1 1 21 M8 11 A4 4 0 1 0 8 3 A4 4 0 0 0 8 11 M19 8 L19 14 M16 11 L22 11"; }

        // --- Objects & misc ---------------------------------------------------
        else if (name == "settings") { return "M12 15 A3 3 0 1 0 12 9 A3 3 0 0 0 12 15 M19.4 15 A1.65 1.65 0 0 0 19.7 17.3 L19.8 17.4 A2 2 0 1 1 17 20.2 L16.9 20.1 A1.65 1.65 0 0 0 14.6 19.8 A1.65 1.65 0 0 0 13.6 21.2 L13.6 21.4 A2 2 0 1 1 9.6 21.4 L9.6 21.2 A1.65 1.65 0 0 0 8.6 19.8 A1.65 1.65 0 0 0 7.3 20.1 L7.2 20.2 A2 2 0 1 1 4.4 17.4 L4.5 17.3 A1.65 1.65 0 0 0 4.8 15 A1.65 1.65 0 0 0 3.4 14 L3.2 14 A2 2 0 1 1 3.2 10 L3.4 10 A1.65 1.65 0 0 0 4.8 9 A1.65 1.65 0 0 0 4.5 7.3 L4.4 7.2 A2 2 0 1 1 7.2 4.4 L7.3 4.5 A1.65 1.65 0 0 0 9 4.8 A1.65 1.65 0 0 0 10 3.4 L10 3.2 A2 2 0 1 1 14 3.2 L14 3.4 A1.65 1.65 0 0 0 15 4.8 A1.65 1.65 0 0 0 16.7 4.5 L16.8 4.4 A2 2 0 1 1 19.6 7.2 L19.5 7.3 A1.65 1.65 0 0 0 19.2 9 A1.65 1.65 0 0 0 20.6 10 L20.8 10 A2 2 0 1 1 20.8 14 L20.6 14 A1.65 1.65 0 0 0 19.4 15 Z"; }
        else if (name == "grid") { return "M4 4 L10 4 L10 10 L4 10 Z M14 4 L20 4 L20 10 L14 10 Z M4 14 L10 14 L10 20 L4 20 Z M14 14 L20 14 L20 20 L14 20 Z"; }
        else if (name == "calendar") { return "M4 6 A1 1 0 0 1 5 5 L19 5 A1 1 0 0 1 20 6 L20 20 A1 1 0 0 1 19 21 L5 21 A1 1 0 0 1 4 20 Z M4 10 L20 10 M8 3 L8 7 M16 3 L16 7"; }
        else if (name == "clock") { return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M12 7 L12 12 L15.5 13.5"; }
        else if (name == "lock") { return "M6 11 A1 1 0 0 1 7 10 L17 10 A1 1 0 0 1 18 11 L18 20 A1 1 0 0 1 17 21 L7 21 A1 1 0 0 1 6 20 Z M8 10 L8 7 A4 4 0 0 1 16 7 L16 10 M12 14 L12 17"; }
        else if (name == "unlock") { return "M6 11 A1 1 0 0 1 7 10 L17 10 A1 1 0 0 1 18 11 L18 20 A1 1 0 0 1 17 21 L7 21 A1 1 0 0 1 6 20 Z M8 10 L8 7 A4 4 0 0 1 15.5 5.6 M12 14 L12 17"; }
        else if (name == "eye") { return "M3 12 A9 6 0 0 1 21 12 A9 6 0 0 1 3 12 Z M12 15 A3 3 0 1 0 12 9 A3 3 0 0 0 12 15"; }
        else if (name == "eye-off") { return "M3 12 A9 6 0 0 1 21 12 A9 6 0 0 1 3 12 Z M12 15 A3 3 0 1 0 12 9 A3 3 0 0 0 12 15 M4 4 L20 20"; }
        else if (name == "star") { return "M12 3 L14.7 9.2 L21.5 9.8 L16.4 14.2 L17.9 20.8 L12 17.3 L6.1 20.8 L7.6 14.2 L2.5 9.8 L9.3 9.2 Z"; }
        else if (name == "bookmark") { return "M6 3 L18 3 A1 1 0 0 1 19 4 L19 21 L12 16.5 L5 21 L5 4 A1 1 0 0 1 6 3 Z"; }
        else if (name == "tag") { return "M3.5 11.5 L3.5 4.5 A1 1 0 0 1 4.5 3.5 L11.5 3.5 L20.5 12.5 L12.5 20.5 Z M7.5 7.5 L7.5 7.51"; }
        else if (name == "globe") { return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M3 12 L21 12 M12 3 A13 13 0 0 1 12 21 A13 13 0 0 0 12 3"; }
        else if (name == "map-pin") { return "M12 22 L7.3 12.8 A7 7 0 1 1 16.7 12.8 Z M12 13 A3 3 0 1 0 12 7 A3 3 0 0 0 12 13"; }
        else if (name == "sun") { return "M12 17 A5 5 0 1 0 12 7 A5 5 0 0 0 12 17 M12 1 L12 3 M12 21 L12 23 M4.2 4.2 L5.6 5.6 M18.4 18.4 L19.8 19.8 M1 12 L3 12 M21 12 L23 12 M4.2 19.8 L5.6 18.4 M18.4 5.6 L19.8 4.2"; }
        else if (name == "moon") { return "M21 12.8 A9 9 0 1 1 11.2 3 A7 7 0 0 0 21 12.8 Z"; }
        else if (name == "cloud") { return "M18 18 A4.5 4.5 0 0 0 17.3 9.1 A6 6 0 0 0 5.6 10.4 A4 4 0 0 0 6 18 Z"; }
        else if (name == "wifi") { return "M2 8.5 A15 15 0 0 1 22 8.5 M5.5 12.5 A10 10 0 0 1 18.5 12.5 M9 16.5 A5 5 0 0 1 15 16.5 M12 20 L12 20.01"; }
        else if (name == "battery") { return "M3 8 A1 1 0 0 1 4 7 L17 7 A1 1 0 0 1 18 8 L18 16 A1 1 0 0 1 17 17 L4 17 A1 1 0 0 1 3 16 Z M21 10 L21 14 M6 10 L6 14 M9 10 L9 14"; }
        else if (name == "power") { return "M12 3 L12 12 M17.7 6.3 A8 8 0 1 1 6.3 6.3"; }
        else if (name == "zap") { return "M13 2 L4.5 13 L11 13 L11 22 L19.5 11 L13 11 Z"; }
        else if (name == "shield") { return "M12 22 C12 22 20 18.5 20 12 L20 5 L12 2 L4 5 L4 12 C4 18.5 12 22 12 22 Z M9 12 L11 14 L15.5 9.5"; }
        else if (name == "award") { return "M12 15 A6 6 0 1 0 12 3 A6 6 0 0 0 12 15 M8.5 14 L7 22 L12 19 L17 22 L15.5 14"; }
        else if (name == "shopping-cart") { return "M2 3 L4.5 3 L7 15 L19 15 M7 15 A2 2 0 1 0 7 19 A2 2 0 0 0 7 15 M17 15 A2 2 0 1 0 17 19 A2 2 0 0 0 17 15 M7 12 L19.5 12 L22 6 L5.5 6"; }
        else if (name == "credit-card") { return "M2 6 A1 1 0 0 1 3 5 L21 5 A1 1 0 0 1 22 6 L22 18 A1 1 0 0 1 21 19 L3 19 A1 1 0 0 1 2 18 Z M2 10 L22 10 M6 15 L10 15"; }
        else if (name == "gift") { return "M4 11 L20 11 L20 21 L4 21 Z M2 7 L22 7 L22 11 L2 11 Z M12 7 L12 21 M12 7 C12 7 9.5 7 9.5 4.5 A2.5 2.5 0 0 1 12 7 M12 7 C12 7 14.5 7 14.5 4.5 A2.5 2.5 0 0 0 12 7"; }
        else if (name == "package") { return "M12 2 L21 7 L21 17 L12 22 L3 17 L3 7 Z M3 7 L12 12 L21 7 M12 12 L12 22"; }
        else if (name == "layers") { return "M12 2 L22 7 L12 12 L2 7 Z M2 12 L12 17 L22 12 M2 17 L12 22 L22 17"; }
        else if (name == "monitor") { return "M3 4 A1 1 0 0 1 4 3 L20 3 A1 1 0 0 1 21 4 L21 16 A1 1 0 0 1 20 17 L4 17 A1 1 0 0 1 3 16 Z M8 21 L16 21 M12 17 L12 21"; }
        else if (name == "smartphone") { return "M7 2 A1 1 0 0 1 8 1 L16 1 A1 1 0 0 1 17 2 L17 22 A1 1 0 0 1 16 23 L8 23 A1 1 0 0 1 7 22 Z M10.5 19 L13.5 19"; }
        else if (name == "printer") { return "M6 9 L6 3 L18 3 L18 9 M6 18 L4 18 A1 1 0 0 1 3 17 L3 10 A1 1 0 0 1 4 9 L20 9 A1 1 0 0 1 21 10 L21 17 A1 1 0 0 1 20 18 L18 18 M6 14 L18 14 L18 21 L6 21 Z M9 18 L15 18"; }
        else if (name == "coffee") { return "M4 8 L4 16 A4 4 0 0 0 8 20 L14 20 A4 4 0 0 0 18 16 L18 8 Z M18 10 L19.5 10 A3 3 0 0 1 19.5 16 L18 16 M6 2 L6 5 M10 2 L10 5 M14 2 L14 5"; }
        else if (name == "trending-up") { return "M3 17 L9.5 10.5 L13.5 14.5 L21 7 M15 7 L21 7 L21 13"; }
        else if (name == "trending-down") { return "M3 7 L9.5 13.5 L13.5 9.5 L21 17 M15 17 L21 17 L21 11"; }
        else { // placeholder / fallback: circle + dot
            return "M12 21 A9 9 0 1 0 12 3 A9 9 0 0 0 12 21 M12 12 L12 12.01";
        }
    }

    Path {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.accent-color;
        // Stroke width is in viewbox units: 2.0 reads well at 12–32px sizes;
        // `stroke-weight` scales it for emphasis (active nav, bold states).
        stroke-width: 2 * root.stroke-weight * 1px;
        fill: transparent;
        commands: root.d;
    }
}
