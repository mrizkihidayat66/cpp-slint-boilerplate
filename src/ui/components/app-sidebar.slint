// AppSidebar — dark vertical navigation rail with brand header.
//
// Responsive behavior: the parent sets `collapsed` (typically when the window
// width drops below a threshold, e.g. `root.width < 600px`) and the rail
// shrinks to icons only.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppIcon } from "app-icon.slint";

export struct AppSidebarItem {
    icon-name: string,
    label: string,
}

export component AppSidebar inherits Rectangle {
    in property <[AppSidebarItem]> items;
    in-out property <int> current-index: 0;
    /// Product name shown in the header (hidden when collapsed).
    in property <string> brand-title;
    /// Short badge next to the title, e.g. a version chip.
    in property <string> brand-subtitle;
    /// Icon-only mode (narrow windows).
    in property <bool> collapsed: false;

    callback navigate(int);

    private property <bool> expanded: !root.collapsed;

    width: root.expanded ? Metrics.sidebar-width : Metrics.sidebar-width-collapsed;
    animate width { duration: 200ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    height: 100%;
    background: Palette.sidebar;

    // Right hairline separating rail from content.
    Rectangle {
        x: parent.width - 1px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Palette.sidebar-border;
    }

    VerticalLayout {
        padding: 0;

        // Brand header
        Rectangle {
            height: 60px;

            HorizontalLayout {
                padding-left: Metrics.space-4;
                padding-right: Metrics.space-4;
                spacing: Metrics.space-3;
                alignment: root.expanded ? start : center;

                // Indigo logo mark — wrapped so it centers vertically in
                // the 60px header (fixed-size children align TOP otherwise).
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 9px;
                        background: Palette.primary;

                        Text {
                            text: "B";
                            color: Palette.text-on-primary;
                            font-size: 14px;
                            font-weight: Typography.font-weight-bold;
                            x: (parent.width - self.preferred-width) / 2;
                            y: (parent.height - self.preferred-height) / 2;
                        }
                    }
                }

                if root.expanded && root.brand-title != "" : VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.brand-title;
                        font-size: Typography.font-size-md;
                        font-weight: Typography.font-weight-semibold;
                        color: Palette.sidebar-brand;
                    }
                    if root.brand-subtitle != "" : Text {
                        text: root.brand-subtitle;
                        font-size: Typography.font-size-xs;
                        color: Palette.sidebar-text;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.sidebar-border; }

        // Nav entries
        VerticalLayout {
            padding: Metrics.space-3;
            padding-top: Metrics.space-4;
            spacing: Metrics.space-1;

            for item[i] in root.items : entry := Rectangle {
                height: 38px;
                border-radius: Metrics.radius-md;

                background: i == root.current-index ? Palette.sidebar-active
                    : entry-area.has-hover ? Palette.sidebar-hover
                    : transparent;

                entry-area := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.current-index = i;
                        root.navigate(i);
                    }
                }

                HorizontalLayout {
                    padding-left: root.expanded ? Metrics.space-3 + 2px : 0;
                    padding-right: Metrics.space-3;
                    spacing: Metrics.space-3;
                    alignment: root.expanded ? start : center;

                    // Fixed-height icon centered vertically in the 38px row.
                    VerticalLayout {
                        alignment: center;
                        AppIcon {
                            name: item.icon-name;
                            size: 17px;
                            stroke-weight: i == root.current-index ? 1.15 : 1;
                            accent-color: i == root.current-index
                                ? Palette.sidebar-text-active
                                : Palette.sidebar-text;
                        }
                    }

                    if root.expanded : Text {
                        text: item.label;
                        font-size: Typography.font-size-md;
                        font-weight: i == root.current-index
                            ? Typography.font-weight-medium : Typography.font-weight-regular;
                        color: i == root.current-index
                            ? Palette.sidebar-text-active
                            : Palette.sidebar-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // Spacer pushes footer to the bottom
        Rectangle { vertical-stretch: 1; }

        // Footer
        if root.expanded : Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: Metrics.space-4;
                padding-right: Metrics.space-4;
                padding-top: Metrics.space-2;
                padding-bottom: Metrics.space-2;
                alignment: start;
                spacing: Metrics.space-3;

                // Version pill — vertically centered, "v0.1" centered inside.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 20px;
                        border-radius: Metrics.radius-pill;
                        background: Palette.sidebar-hover;
                        Text {
                            text: "v0.1";
                            font-size: 9px;
                            color: Palette.sidebar-text;
                            x: (parent.width - self.preferred-width) / 2;
                            y: (parent.height - self.preferred-height) / 2;
                        }
                    }
                }
                Text {
                    text: "cpp-slint-boilerplate";
                    font-size: Typography.font-size-xs;
                    color: Palette.sidebar-text;
                    vertical-alignment: center;
                }
            }
        }
    }
}
