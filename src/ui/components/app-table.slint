// AppTable — virtualized tabular data on top of ListView.
//
// Row model: [{ cells: [string] }]. Sorting: clicking a header emits
// `sort-requested(column, ascending-toggle)`; the owner reorders the model —
// keeping business logic out of the view (see docs/ARCHITECTURE.md).

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppIcon } from "app-icon.slint";
import { ListView } from "std-widgets.slint";

export struct AppTableColumn {
    title: string,
    /// Relative column width weight (all columns share 100%).
    weight: float,
}

export struct AppTableRow {
    cells: [string],
}

export component AppTable inherits Rectangle {
    /// Column definitions.
    in property <[AppTableColumn]> columns;
    /// Row data.
    in property <[AppTableRow]> rows;
    /// Clickable headers with sort indicators.
    in property <bool> sortable: true;
    /// Currently sorted column (-1 = none).
    in property <int> sort-column: -1;
    in property <bool> sort-ascending: true;
    /// Row height.
    in property <length> row-height: Metrics.control-height-md;
    in property <bool> striped: true;
    in property <bool> bordered: true;
    /// Sum of all column weights; column widths are proportional to
    /// weight/total. Slint has no loop statements, so the owner supplies
    /// this when columns are set (defaults to the column count so that
    /// unset weights mean "equal widths").
    in property <float> total-weight: root.columns.length;

    callback row-activated(int, AppTableRow);
    callback sort-requested(int, bool);

    /// Height cap so long tables don't grow the page unboundedly.
    in property <length> max-content-height: 480px;

    width: 100%;
    // Deterministic content height: ListView's own preferred height is not
    // defined (viewport widget), so compute header + rows ourselves.
    height: min(header.height + root.row-height * root.rows.length,
        root.max-content-height);

    border-radius: Metrics.radius-md;
    background: Palette.surface;
    border-width: root.bordered ? Metrics.border-width : 0;
    border-color: Palette.border;
    clip: true;

    header := Rectangle {
        y: 0;
        height: Metrics.control-height-sm;
        width: parent.width;
        background: Palette.surface-alt;

        HorizontalLayout {
            height: 100%;

        for col[c] in root.columns : Rectangle {
            width: root.width * (col.weight > 0 ? col.weight : 1) / root.total-weight;

            if root.sortable : sort-area := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.sort-requested(c, !(root.sort-column == c && root.sort-ascending));
                }
            }

            HorizontalLayout {
                padding-left: Metrics.space-3;
                padding-right: Metrics.space-2;
                spacing: Metrics.space-1;

                Text {
                    text: col.title;
                    font-size: Typography.font-size-xs;
                    font-weight: Typography.font-weight-bold;
                    color: Palette.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // Fixed-height sort indicator centered vertically — a bare
                // child in a HorizontalLayout aligns to the TOP.
                if root.sort-column == c : VerticalLayout {
                    alignment: center;
                    AppIcon {
                        name: root.sort-ascending ? "chevron-up" : "chevron-down";
                        size: Typography.font-size-xs;
                        accent-color: Palette.primary;
                    }
                }
            }
        }
        }
    }

    rows-view := ListView {
        y: header.height;
        width: parent.width;
        height: parent.height - header.height;

        for row[r] in root.rows : Rectangle {
            height: root.row-height;
            background: row-area.has-hover ? Palette.surface-alt
                : root.striped && Math.mod(r, 2) == 1 ? Palette.background
                : transparent;

            row-area := TouchArea {
                clicked => {
                    root.row-activated(r, row);
                }
            }

            HorizontalLayout {
                padding: 0;

                for cell[i] in row.cells : HorizontalLayout {
                    // Same left inset as the header so body text lines up
                    // with the column titles.
                    padding-left: Metrics.space-3;
                    padding-right: Metrics.space-2;

                    Text {
                        width: root.width * (root.columns[i].weight > 0 ? root.columns[i].weight : 1)
                            / root.total-weight;
                        text: cell;
                        font-size: Typography.font-size-sm;
                        color: Palette.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Palette.border;
            }
        }
    }


}
