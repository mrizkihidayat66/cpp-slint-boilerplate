// AppTooltip — wraps arbitrary content and shows a tip on hover.
//
// The wrapped content is the single @children slot; the tip renders above
// (or beside) it on hover.

import { Palette, Typography, Metrics } from "../theme/theme.slint";

export enum AppTooltipPlacement { top, bottom, left, right }

export component AppTooltip inherits Rectangle {
    in property <string> text;
    /// Tip placement.
    in property <AppTooltipPlacement> placement: AppTooltipPlacement.top;
    /// Delay before the tip appears.
    in property <duration> delay: 400ms;

    /// Content to wrap.
    @children

    background: transparent;

    touch := TouchArea {
        mouse-cursor: MouseCursor.help;
    }

    if touch.has-hover : tip := Rectangle {
        x: root.placement == AppTooltipPlacement.left ? -self.width - Metrics.space-2
            : root.placement == AppTooltipPlacement.right ? root.width + Metrics.space-2
            : (root.width - self.width) / 2;
        y: root.placement == AppTooltipPlacement.top ? -self.height - Metrics.space-2
            : root.placement == AppTooltipPlacement.bottom ? root.height + Metrics.space-2
            : (root.height - self.height) / 2;
        height: tip-text.preferred-height + 2 * Metrics.space-1;
        width: min(tip-text.preferred-width + 2 * Metrics.space-2, 280px);
        border-radius: Metrics.radius-sm;
        background: Palette.text;
        drop-shadow-blur: Metrics.elevation-1;
        drop-shadow-color: Palette.shadow;

        tip-text := Text {
            x: Metrics.space-2;
            width: parent.width - 2 * Metrics.space-2;
            y: (parent.height - self.preferred-height) / 2;
            text: root.text;
            font-size: Typography.font-size-xs;
            color: Palette.surface;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}
