// AppInput — single-line text input with label, icon, and error states.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppIcon } from "app-icon.slint";

export component AppInput inherits Rectangle {
    /// Current value.
    in-out property <string> text;
    /// Floating/leading label above the field. Empty hides it.
    in property <string> label;
    /// Placeholder shown when empty.
    in property <string> placeholder;
    /// Leading icon name (AppIcon).
    in property <string> icon-name;
    /// Validation error; non-empty shows the message and error styling.
    in property <string> error-text;
    /// Helper text below the field (hidden when error-text is set).
    in property <string> helper-text;
    in property <bool> disabled: false;
    in property <bool> read-only: false;
    /// Clear button appears when non-empty and enabled.
    in property <bool> clearable: true;
    in property <bool> password: false;

    /// Emitted on Enter/Return.
    callback accepted();
    /// Emitted on every keystroke.
    callback edited();
    /// Emitted when the clear button is used.
    callback cleared();

    background: transparent;

    private property <bool> has-error: root.error-text != "";

    VerticalLayout {
        // Label
        if root.label != "" : Text {
            text: root.label;
            font-size: Typography.font-size-sm;
            font-weight: Typography.font-weight-medium;
            color: root.disabled ? Palette.text-disabled
                : root.has-error ? Palette.danger : Palette.text-muted;
        }
        if root.label != "" : Rectangle { height: Metrics.space-1; }

        // Field
        Rectangle {
            height: Metrics.control-height-md;
            border-radius: Metrics.radius-md;
            background: root.disabled ? Palette.surface-alt : Palette.surface;
            border-width: Metrics.border-width;
            border-color: root.has-error ? Palette.danger
                : input.has-focus ? Palette.primary : Palette.border;

            HorizontalLayout {
                padding-left: Metrics.space-3;
                padding-right: Metrics.space-2;
                spacing: Metrics.space-2;

                // Fixed-height icon centered vertically — a bare child in a
                // HorizontalLayout aligns to the TOP.
                if root.icon-name != "" : VerticalLayout {
                    alignment: center;
                    AppIcon {
                        name: root.icon-name;
                        size: Typography.font-size-md;
                        accent-color: root.disabled ? Palette.text-disabled : Palette.text-muted;
                    }
                }

                input := TextInput {
                    text <=> root.text;
                    font-size: Typography.font-size-md;
                    font-family: Typography.font-family;
                    color: root.disabled ? Palette.text-disabled : Palette.text;
                    vertical-alignment: center;
                    enabled: !root.disabled && !root.read-only;
                    input-type: root.password ? InputType.password : InputType.text;
                    accepted => { root.accepted(); }
                    edited => { root.edited(); }
                }

                if root.clearable && !root.disabled && !root.read-only && root.text != "" : VerticalLayout {
                    alignment: center;
                    clear-touch := TouchArea {
                        width: clear-glyph.width + Metrics.space-1;
                        clicked => {
                            root.text = "";
                            root.cleared();
                            root.edited();
                        }
                        clear-glyph := AppIcon {
                            name: "close";
                            size: Typography.font-size-sm;
                            accent-color: Palette.text-muted;
                        }
                    }
                }
            }
        }

        // Helper / error text
        if root.has-error || root.helper-text != "" : Rectangle { height: Metrics.space-1; }
        if root.has-error || root.helper-text != "" : Text {
            text: root.has-error ? root.error-text : root.helper-text;
            font-size: Typography.font-size-xs;
            color: root.has-error ? Palette.danger : Palette.text-muted;
            overflow: elide;
        }
    }
}
