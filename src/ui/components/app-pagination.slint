// AppPagination — page navigation composed of AppButtons.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppButton, AppButtonVariant, AppButtonSize } from "app-button.slint";
import { AppIcon } from "app-icon.slint";

export component AppPagination inherits Rectangle {
    /// 1-based current page.
    in-out property <int> page: 1;
    in property <int> page-count: 1;
    /// How many numbered buttons surround the current page.
    in property <int> window-size: 2;
    in property <bool> disabled: false;

    callback page-changed(int);

    function go-to-page(p: int) {
        if (p != root.page) {
            root.page = p;
            root.page-changed(p);
        }
    }

    height: Metrics.control-height-sm;
    width: row.preferred-width;

    public pure function first-visible() -> int {
        return max(1, min(root.page - root.window-size,
            root.page-count - 2 * root.window-size));
    }

    public pure function last-visible() -> int {
        return min(root.page-count, max(root.page + root.window-size,
            1 + 2 * root.window-size));
    }

    row := HorizontalLayout {
        spacing: Metrics.space-1;
        alignment: center;

        if root.page > 1 : AppButton {
            variant: AppButtonVariant.outline;
            size: AppButtonSize.sm;
            text: "‹";
            disabled: root.disabled;
            clicked => {
                if (root.page > 1) {
                    root.page -= 1;
                    root.page-changed(root.page);
                }
            }
        }

        if root.first-visible() > 1 : Text {
            text: "…";
            vertical-alignment: center;
            color: Palette.text-muted;
        }

        // Numbered buttons for the visible window. Slint has no loop
        // statements, so the window is emitted as a fixed set of up to
        // (2*window-size+1) conditional buttons; the C++ side can also feed
        // a page-number model instead (see docs/COMPONENTS.md).
        if root.last-visible() >= root.first-visible() + 0 : AppButton {
            variant: root.first-visible() + 0 == root.page
                ? AppButtonVariant.primary : AppButtonVariant.outline;
            size: AppButtonSize.sm;
            text: root.first-visible() + 0;
            disabled: root.disabled;
            clicked => { root.go-to-page(root.first-visible() + 0); }
        }
        if root.last-visible() >= root.first-visible() + 1 : AppButton {
            variant: root.first-visible() + 1 == root.page
                ? AppButtonVariant.primary : AppButtonVariant.outline;
            size: AppButtonSize.sm;
            text: root.first-visible() + 1;
            disabled: root.disabled;
            clicked => { root.go-to-page(root.first-visible() + 1); }
        }
        if root.last-visible() >= root.first-visible() + 2 : AppButton {
            variant: root.first-visible() + 2 == root.page
                ? AppButtonVariant.primary : AppButtonVariant.outline;
            size: AppButtonSize.sm;
            text: root.first-visible() + 2;
            disabled: root.disabled;
            clicked => { root.go-to-page(root.first-visible() + 2); }
        }
        if root.last-visible() >= root.first-visible() + 3 : AppButton {
            variant: root.first-visible() + 3 == root.page
                ? AppButtonVariant.primary : AppButtonVariant.outline;
            size: AppButtonSize.sm;
            text: root.first-visible() + 3;
            disabled: root.disabled;
            clicked => { root.go-to-page(root.first-visible() + 3); }
        }
        if root.last-visible() >= root.first-visible() + 4 : AppButton {
            variant: root.first-visible() + 4 == root.page
                ? AppButtonVariant.primary : AppButtonVariant.outline;
            size: AppButtonSize.sm;
            text: root.first-visible() + 4;
            disabled: root.disabled;
            clicked => { root.go-to-page(root.first-visible() + 4); }
        }

        if root.last-visible() < root.page-count : Text {
            text: "…";
            vertical-alignment: center;
            color: Palette.text-muted;
        }

        if root.page < root.page-count : AppButton {
            variant: AppButtonVariant.outline;
            size: AppButtonSize.sm;
            text: "›";
            disabled: root.disabled;
            clicked => {
                if (root.page < root.page-count) {
                    root.page += 1;
                    root.page-changed(root.page);
                }
            }
        }
    }
}
