// AppSpinner — indeterminate loading indicator.
//
// Uses the same Path/ArcTo idiom as Slint's own std-widgets spinner: the arc
// start rotates with animation-tick() while its extent breathes via sine.

import { Palette, Typography, Metrics } from "../theme/theme.slint";

export component AppSpinner inherits Rectangle {
    // Visual size of the spinner (square).
    in property <length> size: 16px;
    // Color of the moving arc.
    in property <color> color: Palette.primary;

    width: self.size;
    height: self.size;

    path := Path {
        private property <float> radius: 50 - stroke-width / 2;
        private property <float> cx: 50;
        private property <float> cy: 50;
        private property <float> start: mod(animation-tick(), 3s) / 3s;
        private property <float> progress:
            min(0.9999, max(0.20, abs(sin(360deg * animation-tick() / 1.5s))));

        viewbox-width: 100;
        viewbox-height: 100;
        width: 100%;
        height: 100%;

        stroke: root.color;
        // Stroke is expressed in viewbox units; 8 keeps the arc readable
        // across the sizes the components actually use (12–32px).
        stroke-width: 8;

        MoveTo {
            x: path.cx - path.radius * sin(-(path.start - 0.001) * 360deg);
            y: path.cy - path.radius * cos(-(path.start - 0.001) * 360deg);
        }
        LineTo {
            x: path.cx - path.radius * sin(-path.start * 360deg);
            y: path.cy - path.radius * cos(-path.start * 360deg);
        }
        ArcTo {
            radius-x: path.radius;
            radius-y: path.radius;
            x: path.cx - path.radius * sin(-(path.start + path.progress) * 360deg);
            y: path.cy - path.radius * cos(-(path.start + path.progress) * 360deg);
            sweep: path.progress > 0;
            large-arc: path.progress > 0.5;
        }
    }
}
