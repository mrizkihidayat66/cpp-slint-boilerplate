// AppAvatar — user/entity representation with initials fallback.
//
// Slint strings cannot be split or indexed, so initials are pre-built on the
// C++ side ("Ada Lovelace" → "AL") and passed via the `initials` property.

import { Palette, Typography, Metrics } from "../theme/theme.slint";

export enum AppAvatarSize { sm, md, lg }

export component AppAvatar inherits Rectangle {
    /// Pre-built initials shown when no image is set (e.g. "AL").
    in property <string> initials;
    /// Full name; used as fallback text when initials are empty.
    in property <string> name;
    /// Optional image (overrides initials).
    in property <image> source;
    in property <AppAvatarSize> size: AppAvatarSize.md;
    /// Colored status dot (color set via status-color).
    in property <bool> show-status: false;
    in property <color> status-color: Palette.success;

    private property <length> dimension:
        root.size == AppAvatarSize.sm ? 24px
        : root.size == AppAvatarSize.lg ? 48px
        : 32px;
    private property <length> initials-size:
        root.size == AppAvatarSize.sm ? Typography.font-size-xs
        : root.size == AppAvatarSize.lg ? Typography.font-size-lg
        : Typography.font-size-sm;

    width: root.dimension;
    height: root.dimension;
    border-radius: root.dimension / 2;
    background: Palette.primary-tint;
    clip: true;

    if root.source.width > 0 : Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }

    if root.source.width == 0 : Text {
        text: root.initials != "" ? root.initials
            : root.name != "" ? root.name : "?";
        font-size: root.initials-size;
        font-weight: Typography.font-weight-semibold;
        color: Palette.primary;
    }

    if root.show-status : Rectangle {
        x: root.dimension - self.width;
        y: root.dimension - self.height;
        width: root.dimension / 4 + 2px;
        height: root.dimension / 4 + 2px;
        border-radius: self.width / 2;
        background: root.status-color;
        border-width: 2px;
        border-color: Palette.surface;
    }
}
