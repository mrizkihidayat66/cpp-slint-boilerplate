// AppTextarea — multi-line text editor with label and counter.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
// std-widgets is compiled into the slint-compiler per style (fluent here);
// importing it by file name resolves to the builtin style copy.
import { TextEdit } from "std-widgets.slint";

export component AppTextarea inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <string> placeholder;
    /// Hard character cap; the counter only appears when set (> 0).
    in property <int> maxlength: 0;
    in property <bool> disabled: false;
    in property <bool> read-only: false;
    in property <string> error-text;

    callback edited();

    background: transparent;

    private property <bool> has-error: root.error-text != "";

    VerticalLayout {
        // Label
        if root.label != "" : Text {
            text: root.label;
            font-size: Typography.font-size-sm;
            font-weight: Typography.font-weight-medium;
            color: root.has-error ? Palette.danger : Palette.text-muted;
        }
        if root.label != "" : Rectangle { height: Metrics.space-1; }

        // Editor
        Rectangle {
            height: 84px;
            border-radius: Metrics.radius-md;
            background: root.disabled ? Palette.surface-alt : Palette.surface;
            border-width: Metrics.border-width;
            border-color: root.has-error ? Palette.danger
                : editor.has-focus ? Palette.primary : Palette.border;

            editor := TextEdit {
                x: Metrics.space-3;
                width: parent.width - 2 * Metrics.space-3;
                height: parent.height - 2 * Metrics.space-2;
                y: Metrics.space-2;
                text <=> root.text;
                font-size: Typography.font-size-md;
                font-family: Typography.font-family;
                read-only: root.disabled || root.read-only;
                enabled: !root.disabled;
                edited => { root.edited(); }
            }
        }

        // Counter / error
        if root.has-error || root.maxlength > 0 : Rectangle { height: Metrics.space-1; }
        if root.has-error : Text {
            text: root.error-text;
            font-size: Typography.font-size-xs;
            color: Palette.danger;
        }
        if !root.has-error && root.maxlength > 0 : Text {
            text: root.text.character-count + " / " + root.maxlength;
            font-size: Typography.font-size-xs;
            color: root.text.character-count > root.maxlength
                ? Palette.danger : Palette.text-muted;
        }
    }
}
