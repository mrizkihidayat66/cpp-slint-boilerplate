// AppSwitch — on/off toggle.

import { Palette, Typography, Metrics } from "../theme/theme.slint";

export component AppSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    in property <bool> disabled: false;
    /// When true, the label is rendered before the track (right-aligned rows).
    in property <bool> label-first: true;

    callback toggled();

    private property <length> track-width: 40px;
    private property <length> track-height: 22px;

    height: max(track-height, label-text.preferred-height);
    width: (label != "" ? label-text.preferred-width + Metrics.space-3 : 0) + track-width;

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    track := Rectangle {
        x: root.label-first && root.label != "" ? 0
            : root.width - root.track-width;
        width: root.track-width;
        height: root.track-height;
        y: (root.height - root.track-height) / 2;
        border-radius: root.track-height / 2;
        background: root.disabled
            ? Palette.surface-alt
            : root.checked ? Palette.primary : Palette.border-strong;

        thumb := Rectangle {
            width: root.track-height - 4px;
            height: root.track-height - 4px;
            border-radius: self.width / 2;
            background: white;
            y: (parent.height - self.height) / 2;
            x: root.checked
                ? parent.width - self.width - 2px
                : 2px;

            animate x { duration: 150ms; easing: ease-out; }
        }
    }

    label-text := Text {
        y: (root.height - self.preferred-height) / 2;
        x: root.label-first ? root.track-width + Metrics.space-3 : 0;
        width: root.label != "" ? root.width - root.track-width - Metrics.space-3 : 0;
        text: root.label;
        font-size: Typography.font-size-md;
        color: root.disabled ? Palette.text-disabled : Palette.text;
    }
}
