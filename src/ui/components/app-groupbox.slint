// AppGroupBox — titled frame that visually groups a form section
// (WinForms GroupBox / HTML fieldset). The title floats on the top border
// with a small horizontal inset, the classic fieldset look.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppIcon } from "app-icon.slint";

export component AppGroupBox inherits Rectangle {
    /// Caption on the frame's top border. Empty hides the caption.
    in property <string> title;
    /// Leading caption icon name (AppIcon).
    in property <string> icon-name;
    /// Content padding (named to avoid clashing with the element `padding`).
    in property <length> content-padding: Metrics.space-4;
    /// Fill the parent layout instead of hugging content.
    in property <bool> fill: false;
    /// Color painted behind the caption to interrupt the top border
    /// (`-[ Title ]---`). Must match the surrounding background; defaults
    /// to the card surface most group boxes sit on.
    in property <color> title-background: Palette.surface;

    // Height is driven by the layout (stretch or hug) — same contract as
    // AppPanel; see the note there.
    horizontal-stretch: root.fill ? 1 : 0;
    vertical-stretch: root.fill ? 1 : 0;
    border-radius: Metrics.radius-md;
    border-width: Metrics.border-width;
    border-color: Palette.border;
    background: transparent;

    // Content inset leaves room for the caption that sits on the top border.
    content := VerticalLayout {
        y: root.has-title ? Metrics.space-3 : root.content-padding;
        height: parent.height
            - (root.has-title ? Metrics.space-3 : root.content-padding)
            - root.content-padding;
        padding-left: root.content-padding;
        padding-right: root.content-padding;
        spacing: Metrics.space-3;

        @children
    }

    private property <bool> has-title: root.title != "" || root.icon-name != "";

    if root.has-title : Rectangle {
        // Align the caption with the first pixel of the CONTENT (same inset
        // as content-padding-left below), not with an arbitrary space-3.
        x: root.content-padding;
        y: -8px;
        height: 16px;
        width: title-row.preferred-width + 2 * Metrics.space-2;
        // Opaque backdrop interrupts the top border: `-[ Title ]---`.
        // A transparent fill would leave the border line showing through.
        background: root.title-background;

        title-row := HorizontalLayout {
            padding-left: Metrics.space-2;
            padding-right: Metrics.space-2;
            spacing: Metrics.space-2;
            alignment: start;

            if root.icon-name != "" : VerticalLayout {
                // Fixed-height icon centered against the caption text.
                alignment: center;
                AppIcon {
                    name: root.icon-name;
                    size: Typography.font-size-sm;
                    accent-color: Palette.text-muted;
                }
            }
            Text {
                text: root.title;
                font-size: Typography.font-size-sm;
                font-weight: Typography.font-weight-semibold;
                color: Palette.text-muted;
                vertical-alignment: center;
            }
        }
    }
}
