// AppSlider — numeric range input.
//
// Interaction follows Slint's own SliderBase idiom: pointer-event + moved,
// with value updates going through set-value() so snapping and clamping
// live in one place.

import { Palette, Typography, Metrics } from "../theme/theme.slint";

export component AppSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> disabled: false;
    /// Snap the thumb to `step` increments.
    in property <bool> snap: true;

    callback changed(float);

    height: 24px; // touch-friendly track band
    width: 100%;

    private property <float> range: max(0.0001, root.maximum - root.minimum);
    private property <float> fraction:
        min(1, max(0, (root.value - root.minimum) / root.range));

    function set-value(raw: float) {
        let clamped = min(root.maximum, max(root.minimum, raw));
        // let bindings are immutable; snap via a second binding.
        let v = root.snap && root.step > 0
            ? root.minimum + Math.round((clamped - root.minimum) / root.step) * root.step
            : clamped;
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }

    function position-to-value(x: length) -> float {
        return root.minimum + (x / max(1px, track.width)) * root.range;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.pointer;

        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.up) {
                return;
            }
            root.set-value(root.position-to-value(self.mouse-x));
        }

        moved => {
            if (self.enabled && self.pressed) {
                root.set-value(root.position-to-value(self.mouse-x));
            }
        }
    }

    track := Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: parent.width;
        border-radius: 3px;
        background: Palette.surface-alt;

        fill := Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            height: parent.height;
            border-radius: 3px;
            background: root.disabled ? Palette.primary-disabled : Palette.primary;
        }

        thumb := Rectangle {
            x: min(parent.width - self.width,
                   max(0, parent.width * root.fraction - self.width / 2));
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: white;
            border-width: Metrics.border-width;
            border-color: root.disabled ? Palette.border : Palette.primary;
        }
    }
}
