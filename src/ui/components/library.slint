// library.slint — the public import surface of the component library.
//
// Pages must import components from this file only, never from individual
// component files, so internal file layout can change freely.
//
// NOTE: Slint allows only ONE `export * from` per file, so this index uses
// explicit named re-exports instead.

// Actions
export { AppButton, AppButtonVariant, AppButtonSize } from "app-button.slint";
export { AppSpinner } from "app-spinner.slint";

// Containers
export { AppCard, AppCardElevation } from "app-card.slint";
export { AppDialog } from "app-dialog.slint";

// Forms
export { AppInput } from "app-input.slint";
export { AppTextarea } from "app-textarea.slint";
export { AppCheckbox } from "app-checkbox.slint";
export { AppRadio } from "app-radio.slint";
export { AppSwitch } from "app-switch.slint";
export { AppSelect } from "app-select.slint";
export { AppSlider } from "app-slider.slint";

// Feedback
export { AppBadge, AppBadgeVariant } from "app-badge.slint";
export { AppAlert, AppAlertVariant } from "app-alert.slint";
export { AppProgress } from "app-progress.slint";
export { AppTooltip, AppTooltipPlacement } from "app-tooltip.slint";

// Data display
export { AppTable, AppTableColumn, AppTableRow } from "app-table.slint";
export { AppTabs, AppTabsVariant } from "app-tabs.slint";
export { AppAvatar, AppAvatarSize } from "app-avatar.slint";
export { AppAccordion, AppAccordionItem } from "app-accordion.slint";

// Navigation
export { AppNavbar } from "app-navbar.slint";
export { AppSidebar, AppSidebarItem } from "app-sidebar.slint";
export { AppBreadcrumb } from "app-breadcrumb.slint";
export { AppMenu, AppMenuItem } from "app-menu.slint";
export { AppPagination } from "app-pagination.slint";

// Primitives
export { AppIcon } from "app-icon.slint";
