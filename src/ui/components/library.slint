// library.slint — the public import surface of the component library.
//
// Pages must import components from this file only, never from individual
// component files, so internal file layout can change freely.

// Actions
export * from "app-button.slint";
export * from "app-spinner.slint";

// Containers
export * from "app-card.slint";
export * from "app-dialog.slint";

// Forms
export * from "app-input.slint";
export * from "app-textarea.slint";
export * from "app-checkbox.slint";
export * from "app-radio.slint";
export * from "app-switch.slint";
export * from "app-select.slint";
export * from "app-slider.slint";

// Feedback
export * from "app-badge.slint";
export * from "app-alert.slint";
export * from "app-progress.slint";
export * from "app-tooltip.slint";

// Data display
export * from "app-table.slint";
export * from "app-tabs.slint";
export * from "app-avatar.slint";
export * from "app-accordion.slint";

// Navigation
export * from "app-navbar.slint";
export * from "app-sidebar.slint";
export * from "app-breadcrumb.slint";
export * from "app-menu.slint";
export * from "app-pagination.slint";

// Primitives
export * from "app-icon.slint";
