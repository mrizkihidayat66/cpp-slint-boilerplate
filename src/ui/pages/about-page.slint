// about-page.slint — build/runtime metadata from the AboutService.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppState } from "../app-state.slint";
import { AppInfo } from "../app-info.slint";
import { AppCard } from "../components/library.slint";

// One definition row: muted fixed-width label + value. Kept a top-level
// component (Slint forbids nested component declarations).
component AboutRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    Text {
        text: root.label;
        font-size: Typography.font-size-md;
        color: Palette.text-muted;
        width: 140px;
    }
    Text {
        text: root.value;
        font-size: Typography.font-size-md;
        color: Palette.text;
        horizontal-stretch: 1;
        // Elide so a long value can never widen the page and enable
        // horizontal panning.
        overflow: elide;
    }
}

export component AboutPage inherits Rectangle {
    background: Palette.background;
    clip: true;

    // The Flickable's only child must be a LAYOUT: a plain Rectangle child is
    // vertically centered by Slint's default geometry (and, being no layout,
    // never extends the scrollable height). A layout fills the viewport and
    // makes the page scroll exactly as tall as its content.
    Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: Metrics.space-6;
            spacing: Metrics.space-5;
            alignment: start;

            // --- Header — same shell as the other pages.
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "About";
                    font-size: Typography.font-size-xl;
                    font-weight: Typography.font-weight-bold;
                    color: Palette.text;
                }
                Text {
                    text: "Version and build information";
                    font-size: Typography.font-size-md;
                    color: Palette.text-muted;
                }
            }

            // --- Application — full-width, key facts about the build.
            AppCard {
                title: AppInfo.technical-name;
                subtitle: AppState.about-description;

                // Definition rows, the same visual language as the other
                // pages' lists: muted fixed-width label + value.
                VerticalLayout {
                    spacing: Metrics.space-3;

                    AboutRow { label: "Version"; value: AppState.about-version; }
                    AboutRow { label: "Slint"; value: AppState.about-slint-version; }
                    AboutRow { label: "Compiler"; value: AppState.about-compiler; }
                    AboutRow { label: "Build"; value: AppState.about-build-type; }
                }
            }
        }
    }
}
