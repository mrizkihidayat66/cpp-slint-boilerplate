// about-page.slint — build/runtime metadata from the AboutService.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppState } from "../app-state.slint";
import { AppCard } from "../components/library.slint";

export component AboutPage inherits Rectangle {
    background: Palette.background;

    Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 100%;
            height: content-column.preferred-height + 2 * Metrics.space-6;
            clip: false;

            content-column := VerticalLayout {
                x: Metrics.space-6;
                width: parent.width - 2 * Metrics.space-6;
                y: Metrics.space-6;
                spacing: Metrics.space-5;

                // --- Header — same shell as the other pages.
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "About";
                        font-size: Typography.font-size-xl;
                        font-weight: Typography.font-weight-bold;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Version and build information";
                        font-size: Typography.font-size-md;
                        color: Palette.text-muted;
                        vertical-alignment: center;
                    }
                }

                // --- Application — full-width, key facts about the build.
                AppCard {
                    title: "cpp-slint-boilerplate";
                    subtitle: "A professional C++20 + Slint desktop application boilerplate";

                    VerticalLayout {
                        spacing: Metrics.space-3;

                        Text {
                            text: AppState.about-description;
                            font-size: Typography.font-size-md;
                            color: Palette.text;
                            wrap: word-wrap;
                        }

                        Rectangle { height: Metrics.space-2; }

                        // Key/value rows — one Text pair per line so each row
                        // aligns like the other pages' lists instead of one
                        // monolithic \n-joined blob.
                        HorizontalLayout {
                            Text {
                                text: "Version";
                                font-size: Typography.font-size-md;
                                color: Palette.text-muted;
                                width: 140px;
                            }
                            Text {
                                text: AppState.about-version;
                                font-size: Typography.font-size-md;
                                color: Palette.text;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "Slint";
                                font-size: Typography.font-size-md;
                                color: Palette.text-muted;
                                width: 140px;
                            }
                            Text {
                                text: AppState.about-slint-version;
                                font-size: Typography.font-size-md;
                                color: Palette.text;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "Compiler";
                                font-size: Typography.font-size-md;
                                color: Palette.text-muted;
                                width: 140px;
                            }
                            Text {
                                text: AppState.about-compiler;
                                font-size: Typography.font-size-md;
                                color: Palette.text;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "Build";
                                font-size: Typography.font-size-md;
                                color: Palette.text-muted;
                                width: 140px;
                            }
                            Text {
                                text: AppState.about-build-type;
                                font-size: Typography.font-size-md;
                                color: Palette.text;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                Rectangle { height: 8px; }
            }
        }
    }
}
