// about-page.slint — build/runtime metadata from the AboutService.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppState } from "../app-state.slint";
import { AppCard, AppIcon, AppButton, AppButtonVariant } from "../components/library.slint";

export component AboutPage inherits Rectangle {
    background: Palette.background;

    AppCard {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(480px, parent.width - 2 * Metrics.space-5);
        title: "About";
        header-icon: "ⓘ";

        Text {
            text: AppState.about-text;
            font-size: Typography.font-size-md;
            color: Palette.text;
            wrap: word-wrap;
        }
    }
}
