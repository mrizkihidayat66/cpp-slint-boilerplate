// gallery-page.slint — live showcase of every component in the library,
// in the spirit of Bootstrap's component demos. Each section pairs the
// component with its key properties so the page doubles as documentation.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppState } from "../app-state.slint";
import { GalleryDemoState } from "gallery-extras.slint";
import {
    FormControlsSection, FeedbackSection, AvatarsIconsSection,
    TabsPaginationSection, NavigationSection, DialogsSection, CardsSection,
} from "gallery-sections.slint";
import {
    ButtonAlignmentSection, ContainersSection, DatePickerCheckListSection,
    ImagesSection, ResponsiveGridSection, BindingSection,
} from "gallery-extras.slint";
import {
    AppButton,
    AppButtonVariant,
    AppButtonSize,
    AppButtonTextAlign,
    AppCard,
    AppCardElevation,
    AppSpinner,
    AppInput,
    AppTextarea,
    AppCheckbox,
    AppRadio,
    AppSwitch,
    AppSelect,
    AppSlider,
    AppDatePicker,
    AppProgress,
    AppBadge,
    AppBadgeVariant,
    AppAlert,
    AppAlertVariant,
    AppDialog,
    AppTooltip,
    AppTooltipPlacement,
    AppTabs,
    AppTabsVariant,
    AppAvatar,
    AppAvatarSize,
    AppIcon,
    AppPagination,
    AppNavbar,
    AppBreadcrumb,
    AppCheckList,
    CheckItem,
    AppImage,
    AppImageFit,
    AppPanel,
    AppPanelTone,
    AppGroupBox,
    AppGrid,
    AppGridRow,
    AppGridItem,
} from "../components/library.slint";

component SectionTitle inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    height: 44px;

    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text {
            text: root.title;
            font-size: Typography.font-size-lg;
            font-weight: Typography.font-weight-semibold;
            color: Palette.text;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            font-size: Typography.font-size-sm;
            color: Palette.text-muted;
        }
    }
}

export component GalleryPage inherits Rectangle {
    background: Palette.background;

    flick := Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        // Harness hook: fraction (0..1) of the scrollable height to show —
        // set via AppState.gallery-scroll (mouse-wheel automation is flaky).
        viewport-y: self.viewport-height > self.height
            ? min(1, max(0, AppState.gallery-scroll))
                * (self.viewport-height - self.height)
            : 0;

        VerticalLayout {
            padding: Metrics.space-6;
            spacing: Metrics.space-5;
            alignment: start;

            // --- Header ------------------------------------------------------
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Components";
                    font-size: Typography.font-size-xl;
                    font-weight: Typography.font-weight-bold;
                    color: Palette.text;
                }
                Text {
                    text: "Live showcase of the App* component library";
                    font-size: Typography.font-size-md;
                    color: Palette.text-muted;
                }
            }

            // --- Buttons -----------------------------------------------------
            AppCard {
                title: "Buttons";
                subtitle: "5 variants × 3 sizes, icons, loading, disabled";

                VerticalLayout {
                    spacing: Metrics.space-3;

                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppButton { text: "Primary"; }
                        AppButton { text: "Secondary"; variant: AppButtonVariant.secondary; }
                        AppButton { text: "Outline"; variant: AppButtonVariant.outline; }
                        AppButton { text: "Ghost"; variant: AppButtonVariant.ghost; }
                        AppButton { text: "Danger"; variant: AppButtonVariant.danger; }
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppButton { text: "Small"; size: AppButtonSize.sm; }
                        AppButton { text: "Medium"; size: AppButtonSize.md; }
                        AppButton { text: "Large"; size: AppButtonSize.lg; }
                        AppButton { text: "With icon"; icon-name: "plus"; }
                        AppButton { text: "Loading"; loading: true; }
                        AppButton { text: "Disabled"; disabled: true; }
                    }
                }
            }

            // --- Badges ------------------------------------------------------
            AppCard {
                title: "Badges";
                subtitle: "Semantic variants, pill and dot styles";

                HorizontalLayout {
                    spacing: Metrics.space-2;
                    AppBadge { text: "Primary"; }
                    AppBadge { text: "Success"; variant: AppBadgeVariant.success; dot: true; }
                    AppBadge { text: "Warning"; variant: AppBadgeVariant.warning; }
                    AppBadge { text: "Danger"; variant: AppBadgeVariant.danger; dot: true; }
                    AppBadge { text: "Info"; variant: AppBadgeVariant.info; }
                    AppBadge { text: "Pill neutral"; variant: AppBadgeVariant.neutral; pill: true; }
                }
            }

            FormControlsSection { width: 100%; }
            FeedbackSection { width: 100%; }
            AvatarsIconsSection { width: 100%; }
            TabsPaginationSection { width: 100%; }
            NavigationSection { width: 100%; }
            DialogsSection { width: 100%; }
            CardsSection { width: 100%; }
            // --- Extended sections (separate components to keep
            // the generated code within MSVC nesting limits) -----
            ButtonAlignmentSection { width: 100%; }
            ContainersSection { width: 100%; section-width: root.width; }
            DatePickerCheckListSection { width: 100%; }
            ImagesSection { width: 100%; }
            ResponsiveGridSection { width: 100%; page-width: root.width; }
            BindingSection { width: 100%; }
            Rectangle { height: Metrics.space-4; }
        }
    }

    // Dialog instantiated at page level so its overlay covers everything.
    AppDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        open: GalleryDemoState.dialog-open;
        title: "Confirm action";
        accepted => { GalleryDemoState.dialog-open = false; }
        rejected => { GalleryDemoState.dialog-open = false; }

        VerticalLayout {
            spacing: Metrics.space-4;
            Text {
                text: "This is a modal dialog. The overlay blocks interaction\nwith the page behind it.";
                font-size: Typography.font-size-md;
                color: Palette.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Metrics.space-2;
                alignment: end;
                AppButton { text: "Cancel"; variant: AppButtonVariant.outline; clicked => { GalleryDemoState.dialog-open = false; } }
                AppButton { text: "Confirm"; clicked => { GalleryDemoState.dialog-open = false; } }
            }
        }
    }
}
