// gallery-page.slint — live showcase of every component in the library,
// in the spirit of Bootstrap's component demos. Each section pairs the
// component with its key properties so the page doubles as documentation.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import {
    AppButton,
    AppButtonVariant,
    AppButtonSize,
    AppCard,
    AppCardElevation,
    AppSpinner,
    AppInput,
    AppTextarea,
    AppCheckbox,
    AppRadio,
    AppSwitch,
    AppSelect,
    AppSlider,
    AppProgress,
    AppBadge,
    AppBadgeVariant,
    AppAlert,
    AppAlertVariant,
    AppDialog,
    AppTooltip,
    AppTooltipPlacement,
    AppTabs,
    AppTabsVariant,
    AppAvatar,
    AppAvatarSize,
    AppIcon,
    AppPagination,
    AppNavbar,
    AppBreadcrumb,
} from "../components/library.slint";

export component GalleryPage inherits Rectangle {
    background: Palette.background;
    // The Flickable below can hold rows wider than the viewport at small
    // widths; clip so that content never paints over the sidebar.
    clip: true;

    // Interactive state
    property <string> radio-group: "a";
    property <int> selected-index: 0;
    property <bool> check-a: true;
    property <bool> check-b: false;
    property <bool> switch-a: true;
    property <float> slider-value: 42;
    property <bool> dialog-open: false;
    property <int> current-page: 3;
    property <int> tab-index: 0;
    property <string> input-text: "Ada Lovelace";
    property <string> input-error: "";

    Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        // Pin the content width to the viewport: without this a row wider
        // than the page (wide button/badge rows) makes the whole page
        // horizontally pannable — the "page can be moved" defect.
        content-width: self.width;

        VerticalLayout {
            padding: Metrics.space-6;
            spacing: Metrics.space-5;
            alignment: start;

            // --- Header ------------------------------------------------------
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Components";
                    font-size: Typography.font-size-xl;
                    font-weight: Typography.font-weight-bold;
                    color: Palette.text;
                }
                Text {
                    text: "Live showcase of the App* component library";
                    font-size: Typography.font-size-md;
                    color: Palette.text-muted;
                }
            }

            // --- Buttons -----------------------------------------------------
            AppCard {
                title: "Buttons";
                subtitle: "5 variants × 3 sizes, icons, loading, disabled";

                VerticalLayout {
                    spacing: Metrics.space-3;

                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppButton { text: "Primary"; }
                        AppButton { text: "Secondary"; variant: AppButtonVariant.secondary; }
                        AppButton { text: "Outline"; variant: AppButtonVariant.outline; }
                    }
                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppButton { text: "Ghost"; variant: AppButtonVariant.ghost; }
                        AppButton { text: "Danger"; variant: AppButtonVariant.danger; }
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppButton { text: "Small"; size: AppButtonSize.sm; }
                        AppButton { text: "Medium"; size: AppButtonSize.md; }
                        AppButton { text: "Large"; size: AppButtonSize.lg; }
                    }
                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppButton { text: "With icon"; icon-name: "plus"; }
                        AppButton { text: "Loading"; loading: true; }
                        AppButton { text: "Disabled"; disabled: true; }
                    }
                }
            }

            // --- Badges ------------------------------------------------------
            AppCard {
                title: "Badges";
                subtitle: "Semantic variants, pill and dot styles";

                VerticalLayout {
                    spacing: Metrics.space-2;
                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppBadge { text: "Primary"; }
                        AppBadge { text: "Success"; variant: AppBadgeVariant.success; dot: true; }
                        AppBadge { text: "Warning"; variant: AppBadgeVariant.warning; }
                    }
                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        AppBadge { text: "Danger"; variant: AppBadgeVariant.danger; dot: true; }
                        AppBadge { text: "Info"; variant: AppBadgeVariant.info; }
                        AppBadge { text: "Pill neutral"; variant: AppBadgeVariant.neutral; pill: true; }
                    }
                }
            }

            // --- Form controls -----------------------------------------------
            AppCard {
                title: "Form controls";
                subtitle: "Input, textarea, checkbox, radio, switch, select, slider";

                VerticalLayout {
                    spacing: Metrics.space-4;

                    HorizontalLayout {
                        spacing: Metrics.space-4;

                        VerticalLayout {
                            spacing: Metrics.space-4;
                            horizontal-stretch: 2;

                            AppInput {
                                label: "Name";
                                placeholder: "Enter your name";
                                icon-name: "user";
                                text: root.input-text;
                                edited => {
                                    root.input-error = root.input-text.character-count > 12
                                        ? "Max 12 characters" : "";
                                }
                            }
                            AppInput {
                                label: "With error";
                                text: "bad";
                                error-text: root.input-error;
                                helper-text: "Helper text appears without an error";
                            }
                            AppInput { label: "Disabled"; text: "read only"; disabled: true; }
                        }

                        VerticalLayout {
                            spacing: Metrics.space-4;
                            horizontal-stretch: 1;

                            AppTextarea {
                                label: "Textarea";
                                placeholder: "Multi-line…";
                                maxlength: 120;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-6;

                        VerticalLayout {
                            spacing: Metrics.space-2;
                            Text {
                                text: "Checkbox";
                                font-size: Typography.font-size-sm;
                                color: Palette.text-muted;
                            }
                            AppCheckbox { label: "Checked"; checked: root.check-a; toggled => { root.check-a = !root.check-a; } }
                            AppCheckbox { label: "Unchecked"; checked: root.check-b; }
                            AppCheckbox { label: "Disabled"; disabled: true; checked: true; }
                        }

                        VerticalLayout {
                            spacing: Metrics.space-2;
                            Text {
                                text: "Radio";
                                font-size: Typography.font-size-sm;
                                color: Palette.text-muted;
                            }
                            AppRadio { label: "Option A"; value: "a"; group-value: root.radio-group; selected(v) => { root.radio-group = v; } }
                            AppRadio { label: "Option B"; value: "b"; group-value: root.radio-group; selected(v) => { root.radio-group = v; } }
                        }

                        VerticalLayout {
                            spacing: Metrics.space-2;
                            Text {
                                text: "Switch";
                                font-size: Typography.font-size-sm;
                                color: Palette.text-muted;
                            }
                            AppSwitch { label: "Notifications"; checked: root.switch-a; toggled => { root.switch-a = !root.switch-a; } }
                            AppSwitch { label: "Disabled"; disabled: true; }
                        }

                        VerticalLayout {
                            spacing: Metrics.space-2;
                            Text {
                                text: "Select";
                                font-size: Typography.font-size-sm;
                                color: Palette.text-muted;
                            }
                            AppSelect {
                                model: ["Red", "Green", "Blue"];
                                selected-index: root.selected-index;
                                selected(i, v) => { root.selected-index = i; }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Metrics.space-2;
                        Text {
                            text: "Slider — value: " + round(root.slider-value);
                            font-size: Typography.font-size-sm;
                            color: Palette.text-muted;
                        }
                        AppSlider {
                            value: root.slider-value;
                            minimum: 0;
                            maximum: 100;
                            step: 1;
                            changed(v) => { root.slider-value = v; }
                        }
                    }
                }
            }

            // --- Feedback ----------------------------------------------------
            AppCard {
                title: "Feedback";
                subtitle: "Alerts, progress, spinner, tooltip";

                VerticalLayout {
                    spacing: Metrics.space-3;

                    AppAlert { title: "Heads up"; text: "Info alert with a dismiss button."; variant: AppAlertVariant.info; dismissible: true; }
                    AppAlert { text: "Operation completed successfully."; variant: AppAlertVariant.success; }
                    AppAlert { text: "Something needs attention."; variant: AppAlertVariant.warning; }
                    AppAlert { text: "Something went wrong."; variant: AppAlertVariant.danger; }

                    HorizontalLayout {
                        spacing: Metrics.space-4;
                        alignment: start;

                        VerticalLayout {
                            spacing: Metrics.space-2;
                            AppProgress { value: 0.72; show-percentage: true; }
                            AppProgress { value: -1; }  // indeterminate
                        }

                        Rectangle { width: 1px; background: Palette.border; }

                        HorizontalLayout {
                            spacing: Metrics.space-3;
                            alignment: center;
                            AppSpinner { size: 14px; }
                            AppSpinner { size: 20px; }
                            AppSpinner { size: 28px; }
                        }

                        Rectangle { width: 1px; background: Palette.border; }

                        AppTooltip {
                            text: "Hover me for a tooltip";
                            placement: AppTooltipPlacement.top;
                            Text {
                                text: "Hover me";
                                color: Palette.primary;
                                font-size: Typography.font-size-md;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // --- Avatars & icons ---------------------------------------------
            AppCard {
                title: "Avatars & icons";
                subtitle: "Initials fallback, status dot, icon set";

                VerticalLayout {
                    spacing: Metrics.space-4;

                    // Avatars on their own line, left-aligned.
                    HorizontalLayout {
                        spacing: Metrics.space-3;
                        alignment: start;
                        VerticalLayout { alignment: center; AppAvatar { initials: "AL"; name: "Ada Lovelace"; size: AppAvatarSize.sm; } }
                        VerticalLayout { alignment: center; AppAvatar { initials: "GH"; name: "Grace Hopper"; size: AppAvatarSize.md; } }
                        VerticalLayout { alignment: center; AppAvatar { initials: "AT"; name: "Alan Turing"; size: AppAvatarSize.lg; show-status: true; } }
                        VerticalLayout { alignment: center; AppAvatar { initials: "MH"; name: "Margaret Hamilton"; size: AppAvatarSize.lg; show-status: true; status-color: Palette.danger; } }
                    }

                    // Icon set on two lines: 16 icons in a single row is wider
                    // than the minimum window width and Slint layouts do not wrap.
                    HorizontalLayout {
                        spacing: Metrics.space-3;
                        alignment: start;
                        VerticalLayout { alignment: center; AppIcon { name: "home"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "settings"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "search"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "chart"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "calendar"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "document"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "folder"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "edit"; size: 18px; } }
                    }
                    HorizontalLayout {
                        spacing: Metrics.space-3;
                        alignment: start;
                        VerticalLayout { alignment: center; AppIcon { name: "trash"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "check"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "warning"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "activity"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "clock"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "refresh"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "logout"; size: 18px; } }
                        VerticalLayout { alignment: center; AppIcon { name: "image"; size: 18px; } }
                    }
                }
            }

            // --- Tabs & pagination -------------------------------------------
            AppCard {
                title: "Tabs & pagination";
                subtitle: "Underline and pill tabs, page navigation";

                VerticalLayout {
                    spacing: Metrics.space-4;

                    AppTabs {
                        model: ["Overview", "Analytics", "Reports"];
                        current-index: root.tab-index;
                        current-index-changed(i) => { root.tab-index = i; }
                    }

                    AppTabs {
                        model: ["One", "Two", "Three"];
                        variant: AppTabsVariant.pills;
                        current-index: root.tab-index;
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-3;
                        alignment: start;

                        AppPagination {
                            page: root.current-page;
                            page-count: 12;
                            window-size: 2;
                            page-changed(p) => { root.current-page = p; }
                        }
                    }
                }
            }

            // --- Navigation --------------------------------------------------
            AppCard {
                title: "Navigation";
                subtitle: "Navbar and breadcrumb";

                VerticalLayout {
                    spacing: Metrics.space-3;

                    Rectangle {
                        height: 48px;
                        border-radius: Metrics.radius-md;
                        clip: true;
                        AppNavbar {
                            title: "Page title";
                            subtitle: "With subtitle";
                            icon-name: "grid";
                        }
                    }

                    AppBreadcrumb {
                        model: ["Home", "Library", "Data"];
                        navigate(i) => { }
                    }
                }
            }

            // --- Dialogs -----------------------------------------------------
            AppCard {
                title: "Dialogs";
                subtitle: "Modal overlay";

                AppButton {
                    text: "Open dialog";
                    icon-name: "document";
                    clicked => { root.dialog-open = true; }
                }
            }

            // --- Cards -------------------------------------------------------
            AppCard {
                title: "Cards";
                subtitle: "Elevation presets: flat, raised, floating";

                // Three cards side by side need ~377px of body width; below that
                // they stack (Slint layouts never wrap, so the row structure
                // itself changes).
                if root.width >= 440px : HorizontalLayout {
                    spacing: Metrics.space-4;

                    AppCard {
                        title: "Flat";
                        elevation: AppCardElevation.flat;
                        horizontal-stretch: 1;
                        Text { text: "bordered: true"; color: Palette.text-muted; font-size: Typography.font-size-sm; }
                    }
                    AppCard {
                        title: "Raised";
                        elevation: AppCardElevation.raised;
                        horizontal-stretch: 1;
                        Text { text: "default elevation"; color: Palette.text-muted; font-size: Typography.font-size-sm; }
                    }
                    AppCard {
                        title: "Floating";
                        elevation: AppCardElevation.floating;
                        horizontal-stretch: 1;
                        Text { text: "for popovers"; color: Palette.text-muted; font-size: Typography.font-size-sm; }
                    }
                }
                if root.width < 440px : VerticalLayout {
                    spacing: Metrics.space-3;

                    AppCard {
                        title: "Flat";
                        elevation: AppCardElevation.flat;
                        Text { text: "bordered: true"; color: Palette.text-muted; font-size: Typography.font-size-sm; }
                    }
                    AppCard {
                        title: "Raised";
                        elevation: AppCardElevation.raised;
                        Text { text: "default elevation"; color: Palette.text-muted; font-size: Typography.font-size-sm; }
                    }
                    AppCard {
                        title: "Floating";
                        elevation: AppCardElevation.floating;
                        Text { text: "for popovers"; color: Palette.text-muted; font-size: Typography.font-size-sm; }
                    }
                }
            }

            Rectangle { height: Metrics.space-4; }
        }
    }

    // Dialog instantiated at page level so its overlay covers everything.
    AppDialog {
        open: root.dialog-open;
        title: "Confirm action";
        accepted => { root.dialog-open = false; }
        rejected => { root.dialog-open = false; }

        VerticalLayout {
            spacing: Metrics.space-4;
            Text {
                text: "This is a modal dialog. The overlay blocks interaction\nwith the page behind it.";
                font-size: Typography.font-size-md;
                color: Palette.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Metrics.space-2;
                alignment: end;
                AppButton { text: "Cancel"; variant: AppButtonVariant.outline; clicked => { root.dialog-open = false; } }
                AppButton { text: "Confirm"; clicked => { root.dialog-open = false; } }
            }
        }
    }
}
