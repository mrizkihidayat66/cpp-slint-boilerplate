// gallery-extras.slint — later sections of the component gallery.
//
// Split into top-level components (not nested inside GalleryPage) to keep
// the generated C++ nesting depth within MSVC's block limit; GalleryPage
// instantiates them in order.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { Date } from "std-widgets.slint";
import {
    AppButton,
    AppButtonVariant,
    AppButtonTextAlign,
    AppCard,
    AppInput,
    AppSwitch,
    AppProgress,
    AppAlert,
    AppAlertVariant,
    AppCheckList,
    AppCheckbox,
    AppDatePicker,
    AppImage,
    AppImageFit,
    AppPanel,
    AppPanelTone,
    AppGroupBox,
    AppGrid,
    AppGridRow,
    AppGridItem,
} from "../components/library.slint";

// Shared demo state — a global is the idiomatic way several sibling
// components react to the same state (change once, everything that reads
// it re-renders). This is the boilerplate's "bind" story in miniature.
export global GalleryDemoState {
    // Classic gallery interactive state
    in-out property <string> radio-group: "a";
    in-out property <int> selected-index: 0;
    in-out property <bool> check-a: true;
    in-out property <bool> check-b: false;
    in-out property <bool> switch-a: true;
    in-out property <float> slider-value: 42;
    in-out property <bool> dialog-open: false;
    in-out property <int> current-page: 3;
    in-out property <int> tab-index: 0;
    in-out property <string> input-text: "Ada Lovelace";
    in-out property <string> input-error: "";

    // Date picker
    in-out property <Date> due-date: { year: 2026, month: 10, day: 8 };
    // Checked list
    in-out property <bool> check-1: true;
    in-out property <bool> check-2: false;
    in-out property <bool> check-3: true;
    in-out property <bool> check-4: false;
    in-out property <bool> check-5: true;
    // Chain reaction demo
    in-out property <bool> chain-enabled: true;
    in-out property <int> chain-count: 0;
    in-out property <string> chain-name: "World";
    // Derived
    out property <int> checked-count: (check-1 ? 1 : 0) + (check-2 ? 1 : 0)
        + (check-3 ? 1 : 0) + (check-4 ? 1 : 0) + (check-5 ? 1 : 0);
    out property <int> checked-total: 5;
}

export component ButtonAlignmentSection inherits Rectangle {
    background: transparent;

AppCard {
    title: "Button content alignment";
    subtitle: "Equal widths, simple left / center / right";

    VerticalLayout {
        spacing: Metrics.space-2;

        // Three equal-width buttons in one row — `block` stretches each
        // to an equal share, and `text-align` does exactly what it says.
        HorizontalLayout {
            spacing: Metrics.space-2;
            AppButton {
                text: "Left";
                block: true;
                text-align: AppButtonTextAlign.left;
            }
            AppButton {
                text: "Center";
                block: true;
                text-align: AppButtonTextAlign.center;
            }
            AppButton {
                text: "Right";
                block: true;
                text-align: AppButtonTextAlign.right;
            }
        }

        // Icon variants on their own line, out of the alignment demo. Five
        // buttons need ~344px; below that they split into two rows (Slint
        // layouts never wrap, so the row structure itself changes).
        if root.width >= 400px : HorizontalLayout {
            spacing: Metrics.space-2;
            AppButton { text: "With icon"; icon-name: "plus"; }
            AppButton { text: "Trailing"; trailing-icon-name: "chevron-right"; }
            AppButton { icon-name: "edit"; square: true; }
            AppButton { icon-name: "trash"; square: true; variant: AppButtonVariant.danger; }
            AppButton { icon-name: "check"; square: true; variant: AppButtonVariant.success; }
        }
        if root.width < 400px : VerticalLayout {
            spacing: Metrics.space-2;
            HorizontalLayout {
                spacing: Metrics.space-2;
                AppButton { text: "With icon"; icon-name: "plus"; }
                AppButton { text: "Trailing"; trailing-icon-name: "chevron-right"; }
            }
            HorizontalLayout {
                spacing: Metrics.space-2;
                AppButton { icon-name: "edit"; square: true; }
                AppButton { icon-name: "trash"; square: true; variant: AppButtonVariant.danger; }
                AppButton { icon-name: "check"; square: true; variant: AppButtonVariant.success; }
            }
        }
    }
}
}

export component ContainersSection inherits Rectangle {
    background: transparent;

AppCard {
    title: "Panels & group boxes";
    subtitle: "AppPanel tones, AppGroupBox fieldset";

    // Three panels side by side need ~548px of section width (the GroupBox
    // fieldset sets the floor); below that they stack. Panel widths come from
    // root.width -- the width the page layout gives THIS section. Sizing from
    // it (not parent.width of the inner layout) breaks the width feedback
    // loop panel.width -> layout -> panel.layoutinfo -> width.
    if root.width >= 560px : HorizontalLayout {
        spacing: Metrics.space-4;

        AppPanel {
            title: "Panel";
            icon-name: "folder";
            width: (root.width - 2 * Metrics.space-5 - 2 * Metrics.space-4
                - 2 * Metrics.space-4) / 3;
            Text {
                text: "Bordered surface with a pinned title row. Use for content grouping.";
                color: Palette.text-muted;
                font-size: Typography.font-size-sm;
                wrap: word-wrap;
            }
        }
        AppPanel {
            title: "Tinted panel";
            icon-name: "info";
            tone: AppPanelTone.tinted;
            width: (root.width - 2 * Metrics.space-5 - 2 * Metrics.space-4
                - 2 * Metrics.space-4) / 3;
            Text {
                text: "Tone surface calls attention without an alert's urgency.";
                color: Palette.text-muted;
                font-size: Typography.font-size-sm;
                wrap: word-wrap;
            }
        }
        AppGroupBox {
            title: "GroupBox";
            icon-name: "user";
            width: (root.width - 2 * Metrics.space-5 - 2 * Metrics.space-4
                - 2 * Metrics.space-4) / 3;
            VerticalLayout {
                spacing: Metrics.space-2;
                AppCheckbox { label: "Fieldset member"; checked: true; }
                AppCheckbox { label: "Another member"; }
            }
        }
    }
    if root.width < 560px : VerticalLayout {
        spacing: Metrics.space-4;

        AppPanel {
            title: "Panel";
            icon-name: "folder";
            Text {
                text: "Bordered surface with a pinned title row. Use for content grouping.";
                color: Palette.text-muted;
                font-size: Typography.font-size-sm;
                wrap: word-wrap;
            }
        }
        AppPanel {
            title: "Tinted panel";
            icon-name: "info";
            tone: AppPanelTone.tinted;
            Text {
                text: "Tone surface calls attention without an alert's urgency.";
                color: Palette.text-muted;
                font-size: Typography.font-size-sm;
                wrap: word-wrap;
            }
        }
        AppGroupBox {
            title: "GroupBox";
            icon-name: "user";
            VerticalLayout {
                spacing: Metrics.space-2;
                AppCheckbox { label: "Fieldset member"; checked: true; }
                AppCheckbox { label: "Another member"; }
            }
        }
    }
}
}

export component DatePickerCheckListSection inherits Rectangle {
    background: transparent;

AppCard {
    title: "Date picker & checked list";
    subtitle: "AppDatePicker calendar popup, AppCheckList multi-select";

    HorizontalLayout {
        spacing: Metrics.space-6;

        VerticalLayout {
            spacing: Metrics.space-4;
            horizontal-stretch: 1;
            AppDatePicker {
                label: "Due date";
                date <=> GalleryDemoState.due-date;
            }
            AppDatePicker { label: "Empty (placeholder)"; }
            AppDatePicker {
                label: "Disabled";
                date: { year: 2026, month: 1, day: 1 };
                disabled: true;
            }
        }

        VerticalLayout {
            spacing: Metrics.space-2;
            horizontal-stretch: 1;

            AppCheckList {
                label: "Assign to";
                visible-rows: 5;
                items: [
                    { label: "Ada Lovelace", checked: GalleryDemoState.check-1, disabled: false },
                    { label: "Grace Hopper", checked: GalleryDemoState.check-2, disabled: false },
                    { label: "Alan Turing", checked: GalleryDemoState.check-3, disabled: false },
                    { label: "Margaret Hamilton", checked: GalleryDemoState.check-4, disabled: false },
                    { label: "Mary Allen Wilkes", checked: GalleryDemoState.check-5, disabled: false },
                    { label: "Edsger Dijkstra", checked: false, disabled: true },
                ];
                item-toggled(index, checked) => {
                    // Chain reaction: flip the source property the
                    // row's `checked` is bound to → the list, the
                    // count, and the progress bar all re-render.
                    if (index == 0) { GalleryDemoState.check-1 = checked; }
                    else if (index == 1) { GalleryDemoState.check-2 = checked; }
                    else if (index == 2) { GalleryDemoState.check-3 = checked; }
                    else if (index == 3) { GalleryDemoState.check-4 = checked; }
                    else if (index == 4) { GalleryDemoState.check-5 = checked; }
                }
            }

            Text {
                text: "Selected members appear in the binding demo below.";
                font-size: Typography.font-size-xs;
                color: Palette.text-muted;
                wrap: word-wrap;
            }
        }
    }
}
}

export component ImagesSection inherits Rectangle {
    background: transparent;

AppCard {
    title: "Images";
    subtitle: "Fit modes, placeholder, checkered backdrop";

    VerticalLayout {
        spacing: Metrics.space-3;

        // Four across needs ~528px; below that the row becomes a 2x2 block
        // (Slint layouts never wrap, so the row structure itself changes).
        if root.width >= 576px : HorizontalLayout {
            spacing: Metrics.space-4;
            height: 140px;

            AppImage {
                caption: "contain (placeholder)";
                fill: true;
            }
            AppImage {
                caption: "cover (placeholder)";
                fit: AppImageFit.cover;
                fill: true;
            }
            AppImage {
                caption: "fill (placeholder)";
                fit: AppImageFit.fill;
                fill: true;
            }
            AppImage {
                caption: "checkered backdrop";
                checkered: true;
                fill: true;
            }
        }
        if root.width < 576px : VerticalLayout {
            spacing: Metrics.space-4;

            HorizontalLayout {
                spacing: Metrics.space-4;
                height: 140px;
                AppImage { caption: "contain (placeholder)"; fill: true; }
                AppImage { caption: "cover (placeholder)"; fit: AppImageFit.cover; fill: true; }
            }
            HorizontalLayout {
                spacing: Metrics.space-4;
                height: 140px;
                AppImage { caption: "fill (placeholder)"; fit: AppImageFit.fill; fill: true; }
                AppImage { caption: "checkered backdrop"; checkered: true; fill: true; }
            }
        }

        Text {
            text: "Empty sources render a themed placeholder (icon + caption) — a missing picture stays visible, never blank. Set `source` from C++ with slint::Image::load_from_path(...).";
            font-size: Typography.font-size-sm;
            color: Palette.text-muted;
            wrap: word-wrap;
        }
    }
}
}

export component ResponsiveGridSection inherits Rectangle {
    background: transparent;
    // The gallery page's own width (fixed by the window, never by content) --
    // the grid resolves breakpoints against it, breaking the width feedback.
    in property <length> page-width;

AppCard {
    title: "Responsive grid";
    subtitle: "12-column AppGrid, Bootstrap-style spans - resize the window";

    VerticalLayout {
        spacing: Metrics.space-3;

        // Live breakpoint readout makes the reflow observable.
        Text {
            text: "viewport: " + floor(grid.viewport-width / 1px) + "px -- "
                + (grid.at-lg ? "lg (>=992px): 4 columns"
                : grid.at-sm ? "sm (>=576px): 2 columns"
                : "xs (<576px): 1 column (stacked)");
            font-size: Typography.font-size-sm;
            color: Palette.text-muted;
        }

        // AppGridRow never wraps (Slint has no flow layout), so a REAL reflow
        // means selecting a different row structure per breakpoint -- the
        // Bootstrap col-lg-3 col-sm-6 col-12 behaviour spelled out with
        // conditional rows. (Placing all four items in ONE row with
        // span: at-lg ? 3 : at-sm ? 6 : 12 does NOT reflow: a single
        // HorizontalLayout splits equal-span cells equally at every width.)
        grid := AppGrid {
            gap: Metrics.space-3;
            viewport-width: root.page-width;

            // lg (>=992px): four 3-span cells in one row.
            if grid.at-lg : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 3; AppCard { title: "1"; Text { text: "col-lg-3"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
                AppGridItem { span: 3; AppCard { title: "2"; Text { text: "col-lg-3"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
                AppGridItem { span: 3; AppCard { title: "3"; Text { text: "col-lg-3"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
                AppGridItem { span: 3; AppCard { title: "4"; Text { text: "col-lg-3"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
            // sm (>=576px but <lg): two 6-span cells per row.
            if grid.at-sm && !grid.at-lg : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 6; AppCard { title: "1"; Text { text: "col-sm-6"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
                AppGridItem { span: 6; AppCard { title: "2"; Text { text: "col-sm-6"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
            if grid.at-sm && !grid.at-lg : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 6; AppCard { title: "3"; Text { text: "col-sm-6"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
                AppGridItem { span: 6; AppCard { title: "4"; Text { text: "col-sm-6"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
            // xs (<576px): one 12-span cell per row (stacked).
            if !grid.at-sm : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 12; AppCard { title: "1"; Text { text: "col-12"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
            if !grid.at-sm : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 12; AppCard { title: "2"; Text { text: "col-12"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
            if !grid.at-sm : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 12; AppCard { title: "3"; Text { text: "col-12"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
            if !grid.at-sm : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 12; AppCard { title: "4"; Text { text: "col-12"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }

            // Mixed spans still compose: a full-width row, then a split row.
            AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem {
                    span: 12;
                    AppCard { title: "Full width"; Text { text: "span 12 - the whole row"; color: Palette.text-muted; font-size: Typography.font-size-sm; } }
                }
            }
            if grid.at-sm : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 6; AppCard { title: "Half"; Text { text: "span 6"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
                AppGridItem { span: 6; AppCard { title: "Half"; Text { text: "span 6"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
            if !grid.at-sm : AppGridRow {
                grid-gap: Metrics.space-3;
                AppGridItem { span: 12; AppCard { title: "Half"; Text { text: "span 12 (stacked at xs)"; color: Palette.text-muted; font-size: Typography.font-size-sm; } } }
            }
        }
    }
}
}

component BindingColumnInput inherits VerticalLayout {
VerticalLayout {
spacing: Metrics.space-3;
horizontal-stretch: 1;
Text {
    text: "1 — Two-way binding";
    font-size: Typography.font-size-sm;
    font-weight: Typography.font-weight-semibold;
    color: Palette.text;
}
HorizontalLayout {
    spacing: Metrics.space-3;
    AppInput {
        label: "Name";
        text <=> GalleryDemoState.chain-name;
        placeholder: "Type here…";
    }
}
Text {
    text: "Live preview: " + GalleryDemoState.chain-name;
    font-size: Typography.font-size-md;
    color: Palette.primary;
}
Rectangle { height: Metrics.space-2; }
Text {
    text: "2 — Chain reaction";
    font-size: Typography.font-size-sm;
    font-weight: Typography.font-weight-semibold;
    color: Palette.text;
}
AppSwitch {
    label: "Enable the button";
    checked <=> GalleryDemoState.chain-enabled;
}
AppButton {
    text: "Counter: " + GalleryDemoState.chain-count;
    disabled: !GalleryDemoState.chain-enabled;
    clicked => { GalleryDemoState.chain-count = GalleryDemoState.chain-count + 1; }
}
}
}

component BindingColumnDerived inherits VerticalLayout {
VerticalLayout {
spacing: Metrics.space-3;
horizontal-stretch: 1;
Text {
    text: "3 — Computed from the checklist";
    font-size: Typography.font-size-sm;
    font-weight: Typography.font-weight-semibold;
    color: Palette.text;
}
Text {
    text: "Checked members: " + GalleryDemoState.checked-count + " of " + GalleryDemoState.checked-total;
    font-size: Typography.font-size-md;
    color: Palette.text;
}
AppProgress {
    value: GalleryDemoState.checked-count / GalleryDemoState.checked-total;
    show-percentage: true;
}
Rectangle { height: Metrics.space-2; }
Text {
    text: "4 — Greeting (combines everything)";
    font-size: Typography.font-size-sm;
    font-weight: Typography.font-weight-semibold;
    color: Palette.text;
}
AppAlert {
    variant: GalleryDemoState.chain-enabled ? AppAlertVariant.success : AppAlertVariant.warning;
    title: "Hello, " + GalleryDemoState.chain-name + "!";
    text: GalleryDemoState.checked-count > 0
        ? GalleryDemoState.checked-count + " members selected · due " + GalleryDemoState.due-date.year
            + "-" + GalleryDemoState.due-date.month + "-" + GalleryDemoState.due-date.day
        : "No members selected yet";
}
}
}

export component BindingSection inherits Rectangle {
    background: transparent;

AppCard {
    title: "Binding & chain reactions";
    subtitle: "Two-way binding, reactive state, control → control propagation";

    // Two columns need ~397px of body width; below that they stack.
    if root.width >= 460px : HorizontalLayout {
        spacing: Metrics.space-6;
        BindingColumnInput { horizontal-stretch: 1; }
        BindingColumnDerived { horizontal-stretch: 1; }
    }
    if root.width < 460px : VerticalLayout {
        spacing: Metrics.space-5;
        BindingColumnInput { }
        BindingColumnDerived { }
    }
}
}

