// dashboard-page.slint — KPI cards + recent activity feed (simple example).
//
// The data lives right here as array literals — that is the point of this
// branch: no models, no services, no adapters, just markup.

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { StatCard, ActivityItem } from "../app-state.slint";
import {
    AppCard,
    AppCardElevation,
    AppIcon,
    AppBadge,
    AppBadgeVariant,
    AppAvatar,
    AppButton,
    AppButtonVariant,
} from "../components/library.slint";

export component DashboardPage inherits Rectangle {
    background: Palette.background;

    // Demo data inline — on this branch there is no C++ side feeding models.
    property <[StatCard]> stat-cards: [
        { title: "Active users", value: "1,248", delta: "+12% this week", trend-positive: true, icon-name: "users" },
        { title: "Revenue", value: "$48.2k", delta: "+8.4% this month", trend-positive: true, icon-name: "chart" },
        { title: "Open issues", value: "17", delta: "-3 since yesterday", trend-positive: true, icon-name: "warning" },
        { title: "Uptime", value: "99.98%", delta: "30-day average", trend-positive: true, icon-name: "check" },
    ];
    property <[ActivityItem]> recent-activity: [
        { actor: "Ada Lovelace", initials: "AL", action: "created project “Analytical Engine”", timestamp: "2 min ago", icon-name: "folder" },
        { actor: "Grace Hopper", initials: "GH", action: "closed issue “Compiler crash on COBOL”", timestamp: "18 min ago", icon-name: "check" },
        { actor: "Alan Turing", initials: "AT", action: "commented on “Decryption milestone”", timestamp: "1 h ago", icon-name: "document" },
        { actor: "Margaret Hamilton", initials: "MH", action: "deployed release v0.4.1", timestamp: "3 h ago", icon-name: "refresh" },
        { actor: "Katherine Johnson", initials: "KJ", action: "updated trajectory calculations", timestamp: "yesterday", icon-name: "chart" },
    ];

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clip: true;

        Flickable {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: Metrics.space-6;
                spacing: Metrics.space-5;

                // --- Page header -----------------------------------------------------
                HorizontalLayout {
                    spacing: Metrics.space-4;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Dashboard";
                            font-size: Typography.font-size-xl;
                            font-weight: Typography.font-weight-bold;
                            color: Palette.text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Overview of your workspace activity";
                            font-size: Typography.font-size-md;
                            color: Palette.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        alignment: center;
                        AppButton {
                            variant: AppButtonVariant.outline;
                            text: "Export";
                            icon-name: "document";
                        }
                        AppButton {
                            variant: AppButtonVariant.primary;
                            text: "New report";
                            icon-name: "plus";
                        }
                    }
                }

                // --- KPI grid --------------------------------------------------------
                HorizontalLayout {
                    spacing: Metrics.space-4;

                    for card[i] in stat-cards : AppCard {
                        elevation: AppCardElevation.raised;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            spacing: Metrics.space-3;

                            HorizontalLayout {
                                spacing: Metrics.space-3;
                                alignment: start;

                                // Tinted icon tile
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: Metrics.radius-sm;
                                    background: Palette.primary-tint;
                                    AppIcon {
                                        name: card.icon-name;
                                        size: 16px;
                                        accent-color: Palette.primary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: card.title;
                                        font-size: Typography.font-size-md;
                                        color: Palette.text-muted;
                                        overflow: elide;
                                    }
                                }
                            }

                            Text {
                                text: card.value;
                                font-size: Typography.font-size-2xl;
                                font-weight: Typography.font-weight-semibold;
                                color: Palette.text;
                            }

                            AppBadge {
                                text: card.delta;
                                variant: card.trend-positive
                                    ? AppBadgeVariant.success
                                    : AppBadgeVariant.danger;
                                dot: true;
                            }
                        }
                    }
                }

                // --- Activity feed ---------------------------------------------------
                AppCard {
                    title: "Recent activity";
                    subtitle: "Latest events across the workspace";
                    header-icon-name: "activity";
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 0;
                        spacing: 0;

                        for activity[i] in recent-activity : Rectangle {
                            height: 56px;
                            background: row-hover.has-hover ? Palette.surface-alt : transparent;

                            row-hover := TouchArea { }

                            HorizontalLayout {
                                padding-left: Metrics.space-2;
                                padding-right: Metrics.space-2;
                                spacing: Metrics.space-3;
                                alignment: start;

                                // Avatar tile
                                AppAvatar {
                                    initials: activity.initials;
                                    width: 34px;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: activity.actor;
                                        font-size: Typography.font-size-md;
                                        font-weight: Typography.font-weight-medium;
                                        color: Palette.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: activity.action;
                                        font-size: Typography.font-size-sm;
                                        color: Palette.text-muted;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                // Timestamp pinned to the right edge.
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: activity.timestamp;
                                        font-size: Typography.font-size-xs;
                                        color: Palette.text-faint;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Row divider (not after the last item)
                            if i < recent-activity.length - 1 : Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                x: Metrics.space-2 + 34px + Metrics.space-3;
                                width: parent.width - self.x - Metrics.space-2;
                                background: Palette.hairline;
                            }
                        }
                    }
                }
            }
        }
    }
}
