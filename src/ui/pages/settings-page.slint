// settings-page.slint — real settings form, persisted by SettingsService.
//
// Controls bind two-way straight to AppState; the Save button fires
// request-save-settings (C++ persists + sets status-message), Reset fires
// request-reload-settings (C++ re-pushes the persisted values, which flow
// back into the controls through the bindings).

import { Palette, Typography, Metrics } from "../theme/theme.slint";
import { AppState } from "../app-state.slint";
import {
    AppCard,
    AppInput,
    AppSelect,
    AppSwitch,
    AppButton,
    AppButtonVariant,
    AppAlert,
    AppAlertVariant,
    AppBadge,
    AppBadgeVariant,
} from "../components/library.slint";

export component SettingsPage inherits Rectangle {
    background: Palette.background;

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clip: true;

        // The Flickable's only child must be a LAYOUT: a plain Rectangle child
        // is vertically centered by Slint's default geometry (and, being no
        // layout, never extends the scrollable height). A layout fills the
        // viewport and makes the page scroll exactly as tall as its content.
        Flickable {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: Metrics.space-6;
                spacing: Metrics.space-5;
                alignment: start;

                // --- Header ------------------------------------------------------------
                HorizontalLayout {
                    spacing: Metrics.space-4;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Settings";
                            font-size: Typography.font-size-xl;
                            font-weight: Typography.font-weight-bold;
                            color: Palette.text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Preferences are persisted to %APPDATA%\\cpp-slint-boilerplate\\settings.json";
                            font-size: Typography.font-size-md;
                            color: Palette.text-muted;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        alignment: center;
                        AppBadge {
                            text: AppState.dark ? "Dark theme" : "Light theme";
                            variant: AppState.dark
                                ? AppBadgeVariant.info
                                : AppBadgeVariant.neutral;
                            dot: true;
                        }
                    }
                }

                // --- Profile card -------------------------------------------------------
                AppCard {
                    title: "Profile";
                    subtitle: "Shown in the sidebar footer";
                    header-icon-name: "users";

                    VerticalLayout {
                        spacing: Metrics.space-4;

                        AppInput {
                            label: "Display name";
                            placeholder: "Your name";
                            text <=> AppState.display-name;
                            icon-name: "users";
                            helper-text: "3–32 characters";
                        }
                    }
                }

                // --- Appearance card ----------------------------------------------------
                AppCard {
                    title: "Appearance";
                    subtitle: "Applies when you save";
                    header-icon-name: "settings";

                    HorizontalLayout {
                        spacing: Metrics.space-4;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Dark theme";
                                font-size: Typography.font-size-md;
                                font-weight: Typography.font-weight-medium;
                                color: Palette.text;
                            }
                            Text {
                                text: "Switch between light and dark palettes";
                                font-size: Typography.font-size-sm;
                                color: Palette.text-muted;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        AppSwitch {
                            checked <=> AppState.dark;
                        }
                    }
                }

                // --- Behavior card ------------------------------------------------------
                AppCard {
                    title: "Behavior";
                    subtitle: "Application-level switches";
                    header-icon-name: "activity";

                    VerticalLayout {
                        spacing: Metrics.space-4;

                        HorizontalLayout {
                            spacing: Metrics.space-4;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Desktop notifications";
                                    font-size: Typography.font-size-md;
                                    font-weight: Typography.font-weight-medium;
                                    color: Palette.text;
                                }
                                Text {
                                    text: "Show a toast when a task completes";
                                    font-size: Typography.font-size-sm;
                                    color: Palette.text-muted;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            AppSwitch {
                                checked <=> AppState.notifications;
                            }
                        }

                        HorizontalLayout {
                            spacing: Metrics.space-4;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Launch on system start";
                                    font-size: Typography.font-size-md;
                                    font-weight: Typography.font-weight-medium;
                                    color: Palette.text;
                                }
                                Text {
                                    text: "Start minimized in the tray";
                                    font-size: Typography.font-size-sm;
                                    color: Palette.text-muted;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            AppSwitch {
                                checked <=> AppState.auto-start;
                            }
                        }
                    }
                }

                // --- Language card ------------------------------------------------------
                AppCard {
                    title: "Language";
                    subtitle: "Interface language";
                    header-icon-name: "document";

                    HorizontalLayout {
                        spacing: Metrics.space-4;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Interface language";
                                font-size: Typography.font-size-md;
                                font-weight: Typography.font-weight-medium;
                                color: Palette.text;
                            }
                            Text {
                                text: "Requires a restart to fully apply";
                                font-size: Typography.font-size-sm;
                                color: Palette.text-muted;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }

                        VerticalLayout {
                            alignment: center;
                            AppSelect {
                                width: 160px;
                                model: ["English", "Bahasa Indonesia"];
                                selected-index <=> AppState.language-index;
                            }
                        }
                    }
                }

                // --- Save bar ------------------------------------------------------------
                // Status alert on its own line so it never competes with
                // the buttons for width; buttons get a fixed-height row.
                if AppState.status-message != "" : AppAlert {
                    variant: AppAlertVariant.success;
                    title: "Saved";
                    text: AppState.status-message;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Metrics.space-3;

                    AppButton {
                        variant: AppButtonVariant.outline;
                        text: "Reset";
                        icon-name: "refresh";
                        clicked => { AppState.request-reload-settings(); }
                    }
                    AppButton {
                        variant: AppButtonVariant.primary;
                        text: "Save settings";
                        icon-name: "check";
                        clicked => { AppState.request-save-settings(); }
                    }
                }

                Rectangle { height: 8px; }
            }
        }
    }
}
