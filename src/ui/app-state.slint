// app-state.slint — shared types and app-wide state.
//
// Kept separate from app-window.slint so pages can import the structs without
// a circular dependency on the window itself. The generated C++ lands in the
// namespace given by slint_target_sources(... NAMESPACE app).

// Data structs shared with C++. POCOs mirror these in src/models/.
export struct StatCard {
    title: string,
    value: string,
    delta: string,
    trend-positive: bool,
    icon-name: string,
}

export struct ActivityItem {
    actor: string,
    /// Pre-built initials (e.g. "AL") — Slint cannot split strings, so the
    /// C++ side assembles them.
    initials: string,
    action: string,
    timestamp: string,
    icon-name: string,
}

// Shared state between the UI and the C++ side. C++ pushes state via
// property setters on this global and receives intents via callbacks.
// The initial page can be overridden via the BOILERPLATE_START_PAGE env
// var (read in Application) — used by the screenshot harness.
export global AppState {
    in-out property <int> current-page: 0;
    in-out property <string> status-message: "";
    // Structured about fields — the About page renders them as key/value
    // rows instead of a \n-joined blob. Defaults keep the page readable in
    // preview/harness runs with no C++ services attached; Application
    // overwrites them at startup.
    in-out property <string> about-description: "A professional C++20 + Slint desktop application boilerplate.";
    in-out property <string> about-version: "(development)";
    in-out property <string> about-slint-version: "(unknown)";
    in-out property <string> about-compiler: "(unknown)";
    in-out property <string> about-build-type: "(unknown)";
    // --- Settings (inherited from examples/intermediate) ---------------------
    // Bound two-way to the settings page controls. C++ maps these to the
    // persisted AppSettings POCO (bool dark <-> "light"/"dark",
    // int language-index <-> "en"/"id").
    in-out property <string> display-name: "";
    in-out property <bool> dark: false;
    in-out property <bool> notifications: true;
    in-out property <bool> auto-start: false;
    in-out property <int> language-index: 0;

    /// Fired by the settings page's Save button; C++ persists via
    /// SettingsService and re-pushes the normalized values.
    callback request-save-settings();
    /// Fired by the settings page's Reset button; C++ re-pushes the values
    /// the service owns (discarding unsaved edits).
    callback request-reload-settings();

    callback request-navigation(int);
    callback request-quit();
}
