// app-state.slint — shared types and app-wide state.
//
// Kept separate from app-window.slint so pages can import the structs without
// a circular dependency on the window itself. The generated C++ lands in the
// namespace given by slint_target_sources(... NAMESPACE app).

// Data structs shared with C++. POCOs mirror these in src/models/.
export struct StatCard {
    title: string,
    value: string,
    delta: string,
    trend-positive: bool,
    icon-name: string,
}

export struct ActivityItem {
    actor: string,
    /// Pre-built initials (e.g. "AL") — Slint cannot split strings, so the
    /// C++ side assembles them.
    initials: string,
    action: string,
    timestamp: string,
    icon-name: string,
}

// Shared state between the UI and the C++ side. C++ pushes state via
// property setters on this global and receives intents via callbacks.
// The initial page can be overridden via the BOILERPLATE_START_PAGE env
// var (read in Application) — used by the screenshot harness.
export global AppState {
    in-out property <int> current-page: 0;
    in-out property <string> status-message: "";
    in-out property <string> about-text: "";
    callback request-navigation(int);
    callback request-quit();
}
