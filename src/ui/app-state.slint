// app-state.slint — shared types and app-wide state (simple example).
//
// Same file as on main, minus the service-oriented fields: the simple
// example keeps only what the markup itself consumes. The generated C++
// lands in the namespace given by slint_target_sources(... NAMESPACE app).

// Data structs used directly in the markup. The simple example has no C++
// POCOs — the dashboard arrays are literals in dashboard-page.slint, so
// nothing here needs to be shared with C++.
export struct StatCard {
    title: string,
    value: string,
    delta: string,
    trend-positive: bool,
    icon-name: string,
}

export struct ActivityItem {
    actor: string,
    initials: string,
    action: string,
    timestamp: string,
    icon-name: string,
}

// Shared state between pages. On this branch it is pure UI state: the
// current page lives on the window (in-out property), and the about text is
// a constant — no C++ pushes anything in.
export global AppState {
    in-out property <string> about-text: "cpp-slint-boilerplate — simple example\n\n"
        + "This branch shows how little C++ a Slint application actually needs:\n"
        + "create the window, run the event loop, done. All data lives in the\n"
        + ".slint markup itself.";
}
