// theme.slint — the single import point for design tokens.
//
// Every component imports { Palette, Typography, Metrics } from this file
// (never from the individual token files), so token layout stays an
// implementation detail of the theme. Slint allows only one `export * from`
// per file, so re-exports here are explicit.

export { Palette } from "colors.slint";
export { Typography } from "typography.slint";
export { Metrics } from "metrics.slint";
